/* ==========================================================
   VUELO DE PALABRAS
   Pixel-art estilo Krillion: pantalla completa, 8-bit, cian
   ========================================================== */

:root {
  --negro: #03070d;
  --cian: #7fe9ff;
  --cian-fuerte: #38d6ff;
  --cian-tenue: rgba(127, 233, 255, 0.55);
  --rosa: #ff3f6e;
  --amarillo: #ffcc33;
  --texto: #9fb3c4;
  --texto-tenue: #5d7488;
  --texto-debil: #3f5266;
  --pixel: 'Silkscreen', 'Courier New', monospace;
  --num: 'VT323', 'Courier New', monospace;
  /* Safe area insets for notches and home indicators */
  --safe-top: env(safe-area-inset-top, 0);
  --safe-bottom: env(safe-area-inset-bottom, 0);
  --safe-left: env(safe-area-inset-left, 0);
  --safe-right: env(safe-area-inset-right, 0);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body { height: 100%; }

body {
  font-family: var(--pixel);
  background: var(--negro);
  color: var(--texto);
  min-height: 100dvh;
  min-height: 100vh; /* fallback */
  overflow: hidden;
  -webkit-font-smoothing: none;
  font-smooth: never;
  touch-action: manipulation;
  user-select: none;
  image-rendering: pixelated;
  /* Safe area padding */
  padding-top: var(--safe-top);
  padding-bottom: var(--safe-bottom);
  padding-left: var(--safe-left);
  padding-right: var(--safe-right);
}

/* líneas de escaneo CRT */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 30;
  pointer-events: none;
  background: repeating-linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.16) 0 1px,
    transparent 1px 3px
  );
  opacity: 0.55;
}

/* ==========================================================
   FONDOS: un escenario por respuesta correcta
   ========================================================== */

.fondo {
  position: fixed;
  inset: 0;
  z-index: -8;
  opacity: 0;
  transition: opacity 0.55s steps(4);
}

.fondo.activa { opacity: 1; }

/* bandeado pixelado común */
.banda-0, .banda-1, .banda-2, .banda-3,
.banda-4, .banda-5, .banda-6, .banda-7 {
  background-size: 100% 6px, 100% 100%;
}

/* 0 · globos aerostáticos · amanecer azul */
.banda-0 {
  background-image:
    repeating-linear-gradient(180deg, rgba(255,255,255,0.045) 0 3px, rgba(0,0,0,0.05) 3px 6px),
    radial-gradient(ellipse 85% 45% at 50% 108%, rgba(255, 176, 94, 0.30) 0%, transparent 70%),
    linear-gradient(180deg, #2a6da8 0%, #1a4a78 55%, #0c2946 100%);
}

/* 1 · nubes altas · cian */
.banda-1 {
  background-image:
    repeating-linear-gradient(180deg, rgba(255,255,255,0.05) 0 3px, rgba(0,0,0,0.05) 3px 6px),
    radial-gradient(ellipse 90% 40% at 55% 112%, rgba(255, 150, 120, 0.16) 0%, transparent 70%),
    linear-gradient(180deg, #2e7d92 0%, #1b5266 55%, #0a2c3c 100%);
}

/* 2 · aviones · azul acero */
.banda-2 {
  background-image:
    repeating-linear-gradient(180deg, rgba(255,255,255,0.04) 0 3px, rgba(0,0,0,0.06) 3px 6px),
    linear-gradient(180deg, #33607e 0%, #1d3c54 55%, #0b2033 100%);
}

/* 3 · cohetes · crepúsculo violeta y naranja */
.banda-3 {
  background-image:
    repeating-linear-gradient(180deg, rgba(255,255,255,0.04) 0 3px, rgba(0,0,0,0.06) 3px 6px),
    linear-gradient(180deg, #5b3a6e 0%, #33204a 45%, #1a1026 75%, #0d0714 100%);
}

/* 4 · órbita terrestre · horizonte del planeta */
.banda-4 {
  background-image:
    repeating-linear-gradient(180deg, rgba(255,255,255,0.035) 0 3px, rgba(0,0,0,0.07) 3px 6px),
    radial-gradient(ellipse 150% 55% at 50% 122%, #3aa6d8 0%, #1a6f9e 22%, #0b4a70 40%, #05263d 55%, transparent 56%),
    linear-gradient(180deg, #16294f 0%, #0b1732 55%, #03060f 100%);
}

/* 5 · planetas · gigantes de colores */
.banda-5 {
  background-image:
    repeating-linear-gradient(180deg, rgba(255,255,255,0.03) 0 3px, rgba(0,0,0,0.08) 3px 6px),
    radial-gradient(circle 34vh at 78% 32%, rgba(255, 150, 90, 0.30) 0%, transparent 70%),
    radial-gradient(circle 26vh at 18% 68%, rgba(110, 170, 255, 0.22) 0%, transparent 70%),
    linear-gradient(180deg, #070d1e 0%, #03060f 60%, #000000 100%);
}

/* 6 · galaxia · violeta brillante */
.banda-6 {
  background-image:
    repeating-linear-gradient(180deg, rgba(255,255,255,0.035) 0 3px, rgba(0,0,0,0.06) 3px 6px),
    radial-gradient(ellipse 60% 42% at 62% 30%, rgba(150, 90, 230, 0.55) 0%, transparent 70%),
    radial-gradient(ellipse 40% 30% at 22% 72%, rgba(240, 70, 160, 0.28) 0%, transparent 70%),
    linear-gradient(180deg, #1c0b38 0%, #120726 55%, #05020d 100%);
}

/* 7 · fuera de la galaxia · magenta profundo */
.banda-7 {
  background-image:
    repeating-linear-gradient(180deg, rgba(255,255,255,0.035) 0 3px, rgba(0,0,0,0.07) 3px 6px),
    radial-gradient(ellipse 70% 55% at 50% 40%, rgba(255, 60, 160, 0.32) 0%, transparent 70%),
    radial-gradient(ellipse 45% 35% at 80% 75%, rgba(90, 140, 255, 0.25) 0%, transparent 70%),
    linear-gradient(180deg, #2a0826 0%, #14041a 55%, #040106 100%);
}

.vineta {
  position: fixed;
  inset: 0;
  z-index: -7;
  pointer-events: none;
  background: radial-gradient(ellipse 75% 70% at 50% 45%, transparent 38%, rgba(0, 0, 0, 0.66) 100%);
}

/* destello al acertar */
.flash {
  position: fixed;
  inset: 0;
  z-index: -5;
  background: #dff3ff;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.45s ease;
}

.flash.activo {
  opacity: 0.55;
  transition: opacity 0.04s ease;
}

/* ==========================================================
   DECORACIÓN
   ========================================================== */

.capa {
  position: fixed;
  inset: 0;
  z-index: -6;
  pointer-events: none;
  overflow: hidden;
  opacity: 0;
  transition: opacity 0.6s steps(3);
}

.capa.activa { opacity: 1; }
.capa.activa.tenue { opacity: 0.32; }

.nube {
  position: absolute;
  animation: derivar steps(30) infinite;
}

.nube-barra {
  position: absolute;
  background: rgba(200, 230, 255, 0.11);
}

@keyframes derivar {
  from { transform: translateX(-40vw); }
  to   { transform: translateX(125vw); }
}

.avion {
  position: absolute;
  left: -90px;
  color: #0c1c2c;
  opacity: 0.9;
  animation: cruzar steps(40) infinite;
}

.avion svg { width: 52px; height: auto; display: block; shape-rendering: crispEdges; }

@keyframes cruzar {
  from { transform: translateX(-12vw); }
  to   { transform: translateX(118vw); }
}

.cohete {
  position: absolute;
  bottom: -160px;
  width: 22px;
  opacity: 0.9;
  animation: elevar steps(45) infinite;
}

.cohete svg { width: 100%; height: auto; display: block; shape-rendering: crispEdges; }

@keyframes elevar {
  from { transform: translateY(0); }
  to   { transform: translateY(-145vh); }
}

.estrella {
  position: absolute;
  background: #dff0ff;
  border-radius: 0;
  animation: titilar steps(2) infinite;
}

@keyframes titilar {
  0%, 100% { opacity: 0.15; }
  50%      { opacity: 0.95; }
}

/* ---------- Globos aerostáticos ---------- */
.globo {
  position: absolute;
  top: -26vh;
  animation: bajar-globo linear infinite;
  will-change: transform;
}

.globo-cuerpo {
  display: block;
  animation: vaiven steps(20) infinite alternate;
}

.globo svg {
  width: 100%;
  height: auto;
  display: block;
  shape-rendering: crispEdges;
}

@keyframes bajar-globo {
  from { transform: translateY(0); }
  to   { transform: translateY(150vh); }
}

@keyframes vaiven {
  from { transform: translateX(-9px) rotate(-2deg); }
  to   { transform: translateX(9px) rotate(2deg); }
}

/* ---------- Satélites ---------- */
.satelite {
  position: absolute;
  left: -100px;
  width: 58px;
  opacity: 0.85;
  animation: cruzar steps(50) infinite;
}

.satelite svg {
  width: 100%;
  height: auto;
  display: block;
  shape-rendering: crispEdges;
}

/* ---------- Planetas ---------- */
.planeta {
  position: absolute;
  top: -46vh;
  border-radius: 50%;
  opacity: 0.62;
  animation: bajar-planeta linear infinite;
  will-change: transform;
  box-shadow: inset -14px -10px 0 rgba(0, 0, 0, 0.32);
}

.planeta.anillo::after {
  content: '';
  position: absolute;
  left: -26%;
  top: 34%;
  width: 152%;
  height: 34%;
  border: 2px solid rgba(255, 232, 190, 0.42);
  border-radius: 50%;
  transform: rotate(-16deg);
  box-shadow: 0 0 12px rgba(255, 232, 190, 0.18);
}

@keyframes bajar-planeta {
  from { transform: translateY(0) rotate(0deg); }
  to   { transform: translateY(190vh) rotate(14deg); }
}

/* ---------- Galaxias ---------- */
.galaxia {
  position: absolute;
  top: -50vh;
  border-radius: 50%;
  opacity: 0.66;
  filter: blur(0.4px);
  animation: bajar-galaxia linear infinite;
  will-change: transform;
}

@keyframes bajar-galaxia {
  from { transform: translateY(0) rotate(-6deg); }
  to   { transform: translateY(210vh) rotate(10deg); }
}

/* ---------- Ráfagas de ascenso ---------- */
.ascenso {
  position: fixed;
  inset: 0;
  z-index: -4;
  overflow: hidden;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.18s linear;
}

.ascenso.activo { opacity: 1; }

.rayo {
  position: absolute;
  top: -34vh;
  background: linear-gradient(180deg, transparent 0%, rgba(214, 244, 255, 0.85) 45%, rgba(127, 233, 255, 0.15) 100%);
  animation: racha linear infinite;
  opacity: 0;
}

.ascenso.activo .rayo { opacity: var(--op, 0.55); }

.ascenso:not(.activo) .rayo { animation-play-state: paused; }

@keyframes racha {
  from { transform: translateY(0); }
  to   { transform: translateY(165vh); }
}

/* ==========================================================
   PÁJARO PIXEL (animación por frames)
   ========================================================== */

.pajaro-juego {
  position: fixed;
  left: 9vw;
  bottom: 17vh;
  width: 94px;
  height: 84px;
  z-index: 2;
  pointer-events: none;
  transition: bottom 1.1s steps(10);
  filter: drop-shadow(0 0 12px rgba(255, 79, 130, 0.55));
}

/* al acertar: subida larga, aleteo rápido y estela */
.pajaro-juego.trepando {
  transition: bottom 1.6s steps(14);
  filter: drop-shadow(0 0 18px rgba(255, 79, 130, 0.85)) drop-shadow(0 0 26px rgba(127, 233, 255, 0.35));
}

.pajaro-juego.sin-transicion { transition: none; }

.pajaro-juego.trepando::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 72%;
  width: 10px;
  height: 130px;
  transform: translateX(-50%);
  background: linear-gradient(180deg, rgba(255, 140, 180, 0.55) 0%, rgba(127, 233, 255, 0.22) 45%, transparent 100%);
  animation: estela 0.32s steps(3) infinite;
}

.pajaro-juego.trepando::after {
  content: '';
  position: absolute;
  inset: -7px;
  border: 2px solid rgba(127, 233, 255, 0.55);
  animation: onda-ascenso 0.7s steps(6) forwards;
}

@keyframes estela {
  0%   { opacity: 0.9; transform: translate(-50%, 0) scaleY(1); }
  100% { opacity: 0; transform: translate(-50%, 20px) scaleY(0.55); }
}

@keyframes onda-ascenso {
  from { opacity: 0.9; transform: scale(0.72); }
  to   { opacity: 0; transform: scale(1.35); }
}

/* el mundo se desplaza hacia abajo mientras el pájaro sube */
body.ascendiendo .fondo.activa,
body.ascendiendo .capa.activa {
  animation: mundo-sube 1.6s steps(9);
}

@keyframes mundo-sube {
  0%   { transform: translateY(-2.4%) scale(1.06); }
  55%  { transform: translateY(0.5%) scale(1.015); }
  100% { transform: translateY(0) scale(1); }
}

.pajaro-juego svg {
  width: 100%;
  height: 100%;
  overflow: visible;
  shape-rendering: crispEdges;
  animation: balanceo steps(2) 0.9s infinite;
}

.ala-arr { animation: frame-arr 0.42s steps(1) infinite; }
.ala-abj { animation: frame-abj 0.42s steps(1) infinite; }

@keyframes frame-arr {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

@keyframes frame-abj {
  0%, 49% { opacity: 0; }
  50%, 100% { opacity: 1; }
}

@keyframes balanceo {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-3px); }
}

/* texto flotante */
.flotante {
  position: fixed;
  z-index: 3;
  font-family: var(--num);
  font-size: 1.5rem;
  color: var(--cian);
  text-shadow: 2px 2px 0 #062433;
  pointer-events: none;
  animation: flotar-texto 1.2s steps(6) forwards;
}

@keyframes flotar-texto {
  from { opacity: 0; transform: translateY(10px); }
  25%  { opacity: 1; transform: translateY(0); }
  to   { opacity: 0; transform: translateY(-48px); }
}

/* ==========================================================
   ICONOS
   ========================================================== */

.icono {
  position: fixed;
  top: 14px;
  z-index: 20;
  width: 42px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8, 20, 32, 0.75);
  border: 2px solid rgba(110, 190, 220, 0.22);
  border-radius: 0;
  color: var(--cian-tenue);
  cursor: pointer;
  box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.5);
  transition: color 0.15s steps(2), border-color 0.15s steps(2);
}

.icono:hover { color: var(--cian); border-color: rgba(127, 233, 255, 0.5); }

.icono svg { width: 18px; height: 18px; }

.icono-menu { left: 14px; }
.icono-sonido { right: 14px; }

.icono-sonido .mudo-linea { display: none; }
.icono-sonido.mudo .ondas { display: none; }
.icono-sonido.mudo .mudo-linea { display: block; }
.icono-sonido.mudo { color: var(--texto-tenue); }

/* ==========================================================
   HUD
   ========================================================== */

.hud {
  position: fixed;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
  width: min(920px, calc(100vw - 130px));
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: start;
  gap: 10px;
  z-index: 10;
  pointer-events: none;
}

.hud-bloque {
  justify-self: center;
  min-width: 104px;
  padding: 7px 16px 8px;
  text-align: center;
  background: rgba(6, 16, 27, 0.8);
  border: 2px solid rgba(96, 168, 196, 0.2);
  border-radius: 0;
  box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.45);
}

.hud-label {
  display: block;
  font-size: 0.5rem;
  letter-spacing: 0.3em;
  color: rgba(127, 233, 255, 0.6);
  margin-bottom: 2px;
}

.hud-valor {
  display: block;
  font-family: var(--num);
  font-size: 1.85rem;
  line-height: 1;
  transform: skewX(-8deg);
  letter-spacing: 0.04em;
}

.hud-valor.cian { color: var(--cian); text-shadow: 2px 2px 0 #062433; }
.hud-valor.rosa { color: var(--rosa); text-shadow: 2px 2px 0 #2b0712; }

.hud-centro {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  padding-top: 4px;
}

.cajas { display: flex; gap: 5px; }

.caja {
  width: 13px;
  height: 13px;
  background: rgba(255, 204, 51, 0.1);
  border: 2px solid rgba(255, 204, 51, 0.4);
  box-shadow: inset 0 0 4px rgba(255, 204, 51, 0.12);
  transition: background 0.15s steps(2);
}

.caja.hecha {
  background: var(--amarillo);
  border-color: var(--amarillo);
  box-shadow: 0 0 8px rgba(255, 204, 51, 0.65);
}

.caja.actual { animation: pulso 0.9s steps(2) infinite; }

@keyframes pulso {
  0%, 100% { border-color: rgba(255, 204, 51, 0.3); }
  50%      { border-color: rgba(255, 204, 51, 0.95); }
}

.hud-sub {
  font-size: 0.45rem;
  letter-spacing: 0.28em;
  color: rgba(255, 204, 51, 0.65);
  text-transform: uppercase;
}

/* ==========================================================
   REGLA LATERAL
   ========================================================== */

.regla {
  position: fixed;
  right: 6px;
  top: 96px;
  bottom: 96px;
  width: 56px;
  z-index: 5;
  pointer-events: none;
}

.tick {
  position: absolute;
  right: 0;
  width: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 4px;
  transform: translateY(50%);
}

.tick .num {
  font-size: 0.44rem;
  letter-spacing: 0.05em;
  color: rgba(127, 200, 224, 0.45);
  white-space: nowrap;
}

.tick .linea {
  width: 7px;
  height: 2px;
  background: rgba(127, 200, 224, 0.4);
}

.tick.grande .linea { width: 11px; background: rgba(127, 200, 224, 0.7); }
.tick.grande .num { color: rgba(127, 200, 224, 0.8); }

.marca-tu {
  position: fixed;
  right: 6px;
  width: 56px;
  bottom: 17vh;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 4px;
  z-index: 6;
  pointer-events: none;
  transform: translateY(50%);
  transition: bottom 1s steps(8);
}

.marca-tu span {
  font-size: 0.48rem;
  letter-spacing: 0.18em;
  color: var(--rosa);
  text-shadow: 1px 1px 0 #2b0712;
  background: #06121c;
  border: 1px solid rgba(255, 63, 110, 0.45);
  padding: 2px 5px 1px;
}

.marca-tu i {
  width: 22px;
  height: 3px;
  background: var(--rosa);
  box-shadow: 0 0 8px rgba(255, 63, 110, 0.8);
  display: block;
}

/* ==========================================================
   AVISO DE NUEVO ESCENARIO
   ========================================================== */

.banner {
  position: fixed;
  top: 100px;
  left: 50%;
  z-index: 11;
  padding: 6px 14px 5px;
  font-size: 0.5rem;
  letter-spacing: 0.28em;
  white-space: nowrap;
  color: var(--amarillo);
  background: rgba(4, 12, 20, 0.88);
  border: 2px solid rgba(255, 204, 51, 0.45);
  box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.5);
  opacity: 0;
  transform: translate(-50%, -8px);
  transition: opacity 0.2s steps(3), transform 0.2s steps(3);
  pointer-events: none;
}

.banner.visible {
  opacity: 1;
  transform: translate(-50%, 0);
}

/* ==========================================================
   ESCENARIO CENTRAL
   ========================================================== */

.escenario {
  position: fixed;
  inset: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 90px 84px 120px 70px;
  pointer-events: none;
}

.vista {
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18px;
  width: min(680px, 100%);
  text-align: center;
  pointer-events: auto;
}

.vista.activa { display: flex; }

.zona {
  font-size: 0.52rem;
  letter-spacing: 0.4em;
  color: rgba(127, 233, 255, 0.55);
  text-transform: uppercase;
  text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.55);
}

.titulo-grande {
  font-family: var(--pixel);
  font-size: clamp(1.05rem, 3.4vw, 1.7rem);
  font-weight: 700;
  letter-spacing: 0.34em;
  color: #c3d5e3;
  text-transform: uppercase;
  line-height: 1.7;
  text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.55);
}

/* ---------- Selector de dificultad ---------- */
.dificultad {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  width: min(430px, 100%);
  margin-top: 2px;
}

.nivel-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 13px 6px 12px;
  font-family: var(--pixel);
  background: rgba(4, 14, 24, 0.72);
  border: 2px solid rgba(96, 168, 196, 0.26);
  color: var(--texto-tenue);
  cursor: pointer;
  box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.45);
  transition: color 0.12s steps(2), border-color 0.12s steps(2), background 0.12s steps(2);
}

.nivel-btn:hover {
  color: var(--texto);
  border-color: rgba(127, 233, 255, 0.55);
}

.nivel-btn.activa {
  color: var(--cian);
  border-color: var(--cian-fuerte);
  background: rgba(12, 40, 56, 0.92);
  box-shadow: 0 0 12px rgba(56, 214, 255, 0.22), 4px 4px 0 rgba(0, 0, 0, 0.45);
}

.nivel-nombre {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.nivel-detalle {
  font-family: var(--num);
  font-size: 0.86rem;
  letter-spacing: 0.05em;
  opacity: 0.78;
}

.nivel-btn.activa .nivel-detalle { color: var(--cian); opacity: 0.95; }

.prompt {
  font-family: var(--pixel);
  font-size: clamp(0.95rem, 3vw, 1.5rem);
  font-weight: 700;
  letter-spacing: 0.2em;
  line-height: 1.9;
  color: #d3e4f0;
  text-transform: uppercase;
  text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.55);
  max-width: 21ch;
}

.barra-tiempo {
  width: min(420px, 74vw);
  height: 4px;
  background: rgba(110, 200, 230, 0.16);
  overflow: hidden;
  border: 1px solid rgba(110, 200, 230, 0.18);
}

.barra-fill {
  height: 100%;
  width: 100%;
  background: var(--cian-fuerte);
  box-shadow: 0 0 10px rgba(56, 214, 255, 0.7);
  transition: width 1s linear, background 0.2s steps(2);
}

.barra-fill.urgente { background: var(--rosa); box-shadow: 0 0 10px rgba(255, 63, 110, 0.8); }

.respuesta { width: min(420px, 74vw); }

#input-respuesta {
  width: 100%;
  padding: 12px 14px;
  font-family: var(--num);
  font-size: 1.35rem;
  letter-spacing: 0.06em;
  text-align: center;
  color: var(--cian);
  background: rgba(4, 14, 24, 0.8);
  border: 2px solid rgba(96, 168, 196, 0.32);
  border-radius: 0;
  outline: none;
  text-transform: uppercase;
  caret-color: var(--cian);
  box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.4);
  transition: border-color 0.15s steps(2);
}

#input-respuesta::placeholder {
  color: #3c5062;
  text-transform: none;
  font-family: var(--pixel);
  font-size: 0.6rem;
  letter-spacing: 0.18em;
}

#input-respuesta:focus {
  border-color: rgba(127, 233, 255, 0.75);
}

.feedback {
  font-family: var(--pixel);
  font-size: clamp(0.75rem, 2.4vw, 1rem);
  letter-spacing: 0.3em;
  color: var(--cian);
  text-transform: uppercase;
  min-height: 20px;
  text-shadow: 2px 2px 0 #062433;
}

.feedback.cero { color: var(--rosa); text-shadow: 2px 2px 0 #2b0712; }

.sublinea {
  font-family: var(--num);
  font-size: 1.05rem;
  letter-spacing: 0.1em;
  color: var(--texto-tenue);
  min-height: 22px;
}

.linea {
  font-family: var(--num);
  font-size: 1.15rem;
  letter-spacing: 0.08em;
  color: var(--texto);
}

.linea.tenue { color: var(--texto-tenue); }

.rosa { color: var(--rosa); }

.puntos-grande {
  font-family: var(--num);
  font-size: clamp(2rem, 7vw, 3rem);
  letter-spacing: 0.14em;
  color: var(--rosa);
  text-shadow: 3px 3px 0 #2b0712;
  transform: skewX(-6deg);
}

.puntos-grande.cero { color: #7d8ea0; text-shadow: 2px 2px 0 rgba(0,0,0,.4); }

/* ==========================================================
   RESUMEN RESULTADOS
   ========================================================== */

.resumen {
  width: min(520px, 82vw);
  max-height: 150px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 10px;
  background: rgba(4, 12, 20, 0.65);
  border: 2px solid rgba(96, 168, 196, 0.16);
  border-radius: 0;
  scrollbar-width: thin;
  scrollbar-color: rgba(127, 233, 255, 0.35) transparent;
}

.resumen::-webkit-scrollbar { width: 8px; }
.resumen::-webkit-scrollbar-track { background: rgba(6, 20, 32, 0.6); }
.resumen::-webkit-scrollbar-thumb { background: rgba(127, 233, 255, 0.3); border: 2px solid rgba(4, 12, 20, 0.9); }
.resumen::-webkit-scrollbar-button { display: none; }

.item-respuesta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-family: var(--num);
  font-size: 1rem;
  letter-spacing: 0.06em;
  color: var(--texto-tenue);
  text-transform: uppercase;
}

.item-respuesta .pts { color: var(--cian); flex: none; }
.item-respuesta .pts.cero { color: var(--rosa); }

/* ==========================================================
   BOTÓN INFERIOR
   ========================================================== */

.pie {
  position: fixed;
  left: 50%;
  bottom: 26px;
  transform: translateX(-50%);
  z-index: 12;
}

.btn-gran {
  min-width: min(400px, 84vw);
  padding: 16px 34px;
  font-family: var(--pixel);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.34em;
  color: var(--cian);
  background: rgba(6, 22, 32, 0.8);
  border: 2px solid rgba(127, 233, 255, 0.8);
  border-radius: 0;
  cursor: pointer;
  text-transform: uppercase;
  box-shadow:
    4px 4px 0 rgba(0, 0, 0, 0.55),
    0 0 22px rgba(56, 214, 255, 0.22),
    inset 2px 2px 0 rgba(255, 255, 255, 0.06);
  transition: background 0.15s steps(2), box-shadow 0.15s steps(2);
}

.btn-gran:hover {
  background: rgba(56, 214, 255, 0.14);
  box-shadow:
    4px 4px 0 rgba(0, 0, 0, 0.55),
    0 0 34px rgba(56, 214, 255, 0.4),
    inset 2px 2px 0 rgba(255, 255, 255, 0.1);
}

.btn-gran:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 rgba(0,0,0,.55); }

.btn-gran:disabled { opacity: 0.45; cursor: default; box-shadow: none; }

/* ==========================================================
   OVERLAY MENÚ
   ========================================================== */

.overlay {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(2, 8, 14, 0.9);
}

.overlay.activa { display: flex; }

.overlay-panel {
  width: min(460px, 100%);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  background: rgba(6, 16, 27, 0.98);
  border: 2px solid rgba(96, 168, 196, 0.3);
  border-radius: 0;
  box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.55);
}

.overlay-titulo {
  font-size: 0.8rem;
  letter-spacing: 0.34em;
  color: var(--cian);
  text-align: center;
}

.overlay-lista {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.overlay-lista li {
  font-family: var(--num);
  font-size: 1.05rem;
  letter-spacing: 0.05em;
  color: var(--texto);
  padding-left: 16px;
  position: relative;
  line-height: 1.4;
}

.overlay-lista li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.55em;
  width: 6px;
  height: 6px;
  background: var(--amarillo);
  box-shadow: 0 0 8px rgba(255, 204, 51, 0.5);
}

/* ==========================================================
   RESPONSIVE
   ========================================================== */

/* Ajuste para notch y safe areas en iOS/Android */
@supports (padding: max(0px)) {
  .hud {
    top: max(12px, var(--safe-top));
  }
  .icono-menu {
    top: max(14px, var(--safe-top));
    left: max(14px, var(--safe-left));
  }
  .icono-sonido {
    top: max(14px, var(--safe-top));
    right: max(14px, var(--safe-right));
  }
  .pie {
    bottom: max(26px, var(--safe-bottom));
  }
  .escenario {
    padding-top: max(90px, calc(90px + var(--safe-top)));
    padding-bottom: max(120px, calc(120px + var(--safe-bottom)));
    padding-left: max(70px, calc(70px + var(--safe-left)));
    padding-right: max(84px, calc(84px + var(--safe-right)));
  }
  .regla {
    right: max(6px, var(--safe-right));
  }
  .marca-tu {
    right: max(6px, var(--safe-right));
  }
}

@media (max-width: 760px) {
  .hud { width: calc(100vw - 108px); top: max(10px, var(--safe-top)); gap: 6px; }

  .hud-bloque { min-width: 84px; padding: 6px 10px; }

  .hud-label { font-size: 0.42rem; letter-spacing: 0.24em; }

  .hud-valor { font-size: 1.45rem; }

  .caja { width: 10px; height: 10px; }

  .hud-sub { font-size: 0.38rem; letter-spacing: 0.2em; }

  .icono { width: 44px; height: 44px; top: max(12px, var(--safe-top)); }
  .icono svg { width: 20px; height: 20px; }
  .icono-menu { left: max(14px, var(--safe-left)); }
  .icono-sonido { right: max(14px, var(--safe-right)); }

  .escenario { padding: max(84px, calc(84px + var(--safe-top))) 40px max(118px, calc(118px + var(--safe-bottom))) max(14px, var(--safe-left)); }

  .regla { right: max(2px, var(--safe-right)); top: 90px; bottom: 96px; width: 34px; }
  .tick .num { display: none; }
  .tick .linea { width: 10px; }
  .marca-tu { right: max(2px, var(--safe-right)); width: 34px; }
  .marca-tu i { width: 16px; }
  .marca-tu span { font-size: 0.42rem; }

  .pajaro-juego { width: 64px; height: 57px; left: 4vw; }

  .prompt { font-size: clamp(0.85rem, 4vw, 1.15rem); letter-spacing: 0.14em; line-height: 1.9; }

  .btn-gran {
    padding: 16px 24px;
    font-size: 0.78rem;
    letter-spacing: 0.26em;
    min-height: 48px; /* Touch target mínimo 44px */
  }
}

@media (max-width: 420px) {
  .dificultad { gap: 8px; }
  .nivel-btn {
    padding: 14px 6px 13px;
    gap: 8px;
    min-height: 48px;
  }
  .nivel-nombre { font-size: 0.58rem; letter-spacing: 0.12em; }
  .nivel-detalle { font-size: 0.8rem; }

  .hud { width: calc(100vw - 60px); }
  .hud-bloque { min-width: 72px; padding: 5px 8px; }
  .hud-valor { font-size: 1.3rem; }

  .cajas { gap: 3px; }
  .caja { width: 9px; height: 9px; }

  .pajaro-juego { width: 56px; height: 50px; }
}

@media (max-height: 600px) {
  .escenario {
    padding-top: max(76px, calc(76px + var(--safe-top)));
    padding-bottom: max(96px, calc(96px + var(--safe-bottom)));
  }
  .resumen { max-height: 96px; }
  .pie { bottom: max(14px, var(--safe-bottom)); }
}

/* Landscape mobile - más espacio vertical */
@media (max-height: 500px) and (orientation: landscape) {
  .escenario {
    padding-top: max(60px, calc(60px + var(--safe-top)));
    padding-bottom: max(80px, calc(80px + var(--safe-bottom)));
  }
  .hud { top: max(8px, var(--safe-top)); }
  .hud-bloque { padding: 4px 6px; }
  .hud-valor { font-size: 1.2rem; }
  .hud-label { font-size: 0.38rem; }
  .caja { width: 8px; height: 8px; }
  .pie { bottom: max(10px, var(--safe-bottom)); }
  .btn-gran { padding: 12px 18px; font-size: 0.68rem; }
  .icono { width: 40px; height: 36px; }
}

/* Mejoras de accesibilidad táctil */
@media (hover: none) and (pointer: coarse) {
  .nivel-btn,
  .btn-gran,
  .icono,
  #input-respuesta {
    min-height: 44px;
  }

  .nivel-btn:active,
  .btn-gran:active,
  .icono:active {
    transform: scale(0.98);
  }

  #input-respuesta {
    font-size: 16px; /* Evita zoom en iOS */
  }
}

/* Prevenir zoom en inputs en iOS */
@media screen and (max-width: 760px) {
  #input-respuesta {
    font-size: 16px !important;
  }
}
