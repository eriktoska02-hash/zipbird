/* ==========================================================
   VUELO DE PALABRAS - lógica
   un escenario distinto por cada respuesta correcta
   ========================================================== */

/* Dificultades: cambian el banco de preguntas y el tiempo por pregunta */
const DIFICULTADES = {
  facil:   { nombre: 'FÁCIL',   tiempo: 30, detalle: 'directas', record: 'vueloRecord_facil' },
  media:   { nombre: 'MEDIO',   tiempo: 25, detalle: 'mezcla',   record: 'vueloRecord_media' },
  dificil: { nombre: 'DIFÍCIL', tiempo: 20, detalle: 'raras',    record: 'vueloRecord_dificil' }
};

let dificultadActual = 'media';
let tiempoLimite = DIFICULTADES.media.tiempo;
const TOTAL_PREGUNTAS = 7;
const MAX_PUNTOS = 700;
const METROS_POR_PUNTO = 10;
const MAX_METROS = MAX_PUNTOS * METROS_POR_PUNTO;
/* cada acierto asciende un tramo completo: 1000 m */
const METROS_POR_ACIERTO = MAX_METROS / TOTAL_PREGUNTAS;

/* Nombre de cada escenario (índice = respuestas correctas) */
const ESCENAS = [
  { nombre: 'GLOBOS AEROSTÁTICOS' },
  { nombre: 'NUBES ALTAS' },
  { nombre: 'AVIONES COMERCIALES' },
  { nombre: 'ZONA DE COHETES' },
  { nombre: 'ÓRBITA TERRESTRE' },
  { nombre: 'PLANETAS' },
  { nombre: 'GALAXIA' },
  { nombre: 'FUERA DE LA GALAXIA' }
];

/* Colores por zona para efectos visuales */
const ZONA_COLORES = {
  0: '#7fe9ff',  // CIELO - cian
  1: '#8aff8a',  // MONTAÑAS - verde
  2: '#ffcc33',  // ESTRATOSFERA - amarillo
  3: '#ff66aa',  // ESPACIO - rosa
  4: '#c899ff'   // UNIVERSO - violeta
};

let estado = 'inicio';
let preguntaActual = 0;
let puntuacion = 0;
let aciertos = 0;
let preguntasPartida = [];
let tiempoRestante = tiempoLimite;
let temporizadorId = null;
let respuestaDada = false;
let reintentando = false;
let sonidoActivo = true;
let audioCtx = null;
let escenaMostrada = -1;
let puntosActuales = 0;
let bannerTimer = null;
let transicionandoPregunta = false;

/* ---------- Combo ---------- */
let comboActual = 0;
let multiplicadorCombo = 1;
let comboMaximoPartida = 0;
let comboUltimoMultiplicador = 1;

/* ---------- Zonas de altitud ---------- */
const ZONAS = [
  { nombre: 'CIELO', altitudMin: 0, altitudMax: 999, capa: 'capa-globos' },
  { nombre: 'MONTAÑAS', altitudMin: 1000, altitudMax: 2499, capa: 'capa-montanas' },
  { nombre: 'ESTRATOSFERA', altitudMin: 2500, altitudMax: 3999, capa: 'capa-estratosfera' },
  { nombre: 'ESPACIO', altitudMin: 4000, altitudMax: 5499, capa: 'capa-orbita' },
  { nombre: 'UNIVERSO', altitudMin: 5500, altitudMax: 7000, capa: 'capa-galaxias' }
];
let zonaActualIndex = 0;
let altitudMaximaPartida = 0;
let zonasVisitadas = new Set([0]);
let zonaRecienCambiada = false;

/* ---------- Logros ---------- */
let logrosDesbloqueadosSet = new Set();
const LOGROS = [
  {
    id: 'primer-vuelo',
    nombre: 'Primer Vuelo',
    descripcion: 'Completa tu primera partida',
    icono: '<path d="M2 26 L44 22 L62 4 L72 4 L62 22 L96 18 L100 26 L96 34 L62 30 L72 46 L62 46 L44 30 L2 28 Z"/>',
    condicion: (s) => s.aciertos >= 1
  },
  {
    id: 'explorador-montanas',
    nombre: 'Explorador',
    descripcion: 'Alcanza la zona de Montañas',
    icono: '<path d="M10 2 L20 18 L30 2 Z M10 18 L30 18 L20 34 Z"/>',
    condicion: (s) => s.altitudMaxima >= 1000
  },
  {
    id: 'explorador-estratosfera',
    nombre: 'Estratonauta',
    descripcion: 'Alcanza la zona de Estratosfera',
    icono: '<path d="M12 2 L22 12 L12 22 L2 12 Z"/>',
    condicion: (s) => s.altitudMaxima >= 2500
  },
  {
    id: 'explorador-espacio',
    nombre: 'Astronauta',
    descripcion: 'Alcanza la zona de Espacio',
    icono: '<circle cx="12" cy="12" r="8"/><path d="M8 12 L16 12 M12 8 L12 16"/>',
    condicion: (s) => s.altitudMaxima >= 4000
  },
  {
    id: 'explorador-universo',
    nombre: 'Viajero del Universo',
    descripcion: 'Alcanza la zona de Universo',
    icono: '<path d="M2 2 L22 2 L22 22 L2 22 Z M6 6 L18 6 L18 18 L6 18 Z"/>',
    condicion: (s) => s.altitudMaxima >= 5500
  },
  {
    id: 'palabra-legendaria',
    nombre: 'Palabra Extraordinaria',
    descripcion: 'Acerta una respuesta legendaria (100 pts)',
    icono: '<path d="M12 2 L2 12 L12 22 L22 12 Z M12 6 L12 18 M6 12 L18 12"/>',
    condicion: (s) => s.tuvoLegendaria
  },
  {
    id: 'racha-perfecta',
    nombre: 'Racha Perfecta',
    descripcion: '7 respuestas correctas consecutivas',
    icono: '<path d="M2 12 L12 2 L22 12 L12 22 Z M6 12 L18 12 M12 6 L12 18"/>',
    condicion: (s) => s.comboMaximo >= 7
  },
  {
    id: 'gran-aviador',
    nombre: 'Gran Aviador',
    descripcion: 'Alcanza 7000 metros de altitud',
    icono: '<path d="M12 2 L2 12 L12 22 L22 12 Z M12 6 L12 18 M6 12 L18 12"/>',
    condicion: (s) => s.altitudMaxima >= 7000
  },
  {
    id: 'perfeccionista',
    nombre: 'Perfeccionista',
    descripcion: 'Completa una partida con 7 aciertos',
    icono: '<circle cx="12" cy="12" r="10" fill="none"/><path d="M8 12 L12 16 L16 12"/>',
    condicion: (s) => s.aciertos === TOTAL_PREGUNTAS
  },
  {
    id: 'coleccionista',
    nombre: 'Coleccionista',
    descripcion: 'Desbloquea 5 logros',
    icono: '<path d="M2 6 L22 6 L22 18 L2 18 Z M6 10 L18 10 M10 6 L10 18 M14 6 L14 18"/>',
    condicion: (s) => s.logrosDesbloqueados >= 5
  },
  {
    id: 'velocista',
    nombre: 'Velocista',
    descripcion: 'Responde 5 preguntas en menos de 10s cada una',
    icono: '<path d="M12 2 L2 12 L12 22 L22 12 Z M12 6 L12 18 M6 12 L18 12"/>',
    condicion: (s) => s.rapidas >= 5
  },
  {
    id: 'cazador-raro',
    nombre: 'Cazador de Raras',
    descripcion: 'Consigue 3 palabras muy raras o legendarias en una partida',
    icono: '<path d="M12 2 L2 7 L7 17 L17 17 L22 7 Z"/>',
    condicion: (s) => s.rarasMuyRaras >= 3
  },
  {
    id: 'maestro-combo',
    nombre: 'Maestro del Combo',
    descripcion: 'Alcanza multiplicador x5 en una partida',
    icono: '<path d="M12 2 L22 12 L12 22 L2 12 Z M12 6 L12 18 M6 12 L18 12"/>',
    condicion: (s) => s.multiplicadorMaximo >= 5
  }
];

/* ---------- Elementos (se inicializan en DOMContentLoaded) ---------- */
let fondos, capaEstrellas, capaGlobos, capaNubes, capaAviones, capaCohetes, capaOrbita, capaPlanetas, capaGalaxias, capaMontanas, capaEstratosfera, efectoAscensoEl, flash, banner;
let pajaro, regla, marcaTu;
let hudAltitud, hudPuntaje, hudEstado, cajas;
let vistaInicio, vistaJuego, vistaResultados, vistaLogros;
let zonaActual, zonaFinal, textoPrompt, barraFill, formRespuesta, inputRespuesta, feedback, sublinea;
let puntosFinales, calificacionFinal, resumen, recordEl;
let hudCombo, comboValor, comboContador, particulasCombo;
let zonaIndicador, zonaNombre, zonaAltitud, zonaProgresoFill;
let btnLogros, btnLogrosInicio, btnCerrarLogros, overlayLogros, logrosGrid, logrosGridOverlay, logrosProgreso, logrosProgresoOverlay, logrosDesbloqueados, logrosLista, toastLogro, toastNombreLogro;
let btnAccion, btnMenu, btnSonido, overlay, btnCerrarMenu;
let botonesNivel, bancoNivel, nivelFinal;

function inicializarElementos() {
  fondos = [...document.querySelectorAll('.fondo')];
  capaEstrellas = document.getElementById('capa-estrellas');
  capaGlobos = document.getElementById('capa-globos');
  capaNubes = document.getElementById('capa-nubes');
  capaAviones = document.getElementById('capa-aviones');
  capaCohetes = document.getElementById('capa-cohetes');
  capaOrbita = document.getElementById('capa-orbita');
  capaPlanetas = document.getElementById('capa-planetas');
  capaGalaxias = document.getElementById('capa-galaxias');
  capaMontanas = document.getElementById('capa-montanas');
  capaEstratosfera = document.getElementById('capa-estratosfera');
  efectoAscensoEl = document.getElementById('efecto-ascenso');
  flash = document.getElementById('flash');
  banner = document.getElementById('banner');

  pajaro = document.getElementById('pajaro-juego');
  regla = document.getElementById('regla');
  marcaTu = document.getElementById('marca-tu');

  hudAltitud = document.getElementById('hud-altitud');
  hudPuntaje = document.getElementById('hud-puntaje');
  hudEstado = document.getElementById('hud-estado');
  cajas = document.getElementById('cajas');

  vistaInicio = document.getElementById('pantalla-inicio');
  vistaJuego = document.getElementById('pantalla-juego');
  vistaResultados = document.getElementById('pantalla-resultados');
  vistaLogros = document.getElementById('pantalla-logros');

  zonaActual = document.getElementById('zona-actual');
  zonaFinal = document.getElementById('zona-final');
  textoPrompt = document.getElementById('texto-prompt');
  barraFill = document.getElementById('barra-fill');
  formRespuesta = document.getElementById('form-respuesta');
  inputRespuesta = document.getElementById('input-respuesta');
  feedback = document.getElementById('mensaje-feedback');
  sublinea = document.getElementById('sublinea-feedback');

  puntosFinales = document.getElementById('puntos-finales');
  calificacionFinal = document.getElementById('calificacion-final');
  resumen = document.getElementById('resumen-respuestas');
  recordEl = document.getElementById('record');

  /* ---------- Combo ---------- */
  hudCombo = document.getElementById('hud-combo');
  comboValor = document.getElementById('combo-valor');
  comboContador = document.getElementById('combo-contador');
  particulasCombo = document.getElementById('particulas-combo');

  /* ---------- Zona de altitud ---------- */
  zonaIndicador = document.getElementById('zona-indicador');
  zonaNombre = document.getElementById('zona-nombre');
  zonaAltitud = document.getElementById('zona-altitud');
  zonaProgresoFill = document.getElementById('zona-progreso-fill');

  /* ---------- Logros ---------- */
  btnLogros = document.getElementById('btn-logros');
  btnLogrosInicio = document.getElementById('btn-logros-inicio');
  btnCerrarLogros = document.getElementById('btn-cerrar-logros');
  overlayLogros = document.getElementById('overlay-logros');
  logrosGrid = document.getElementById('logros-grid');
  logrosGridOverlay = document.getElementById('logros-grid-overlay');
  logrosProgreso = document.getElementById('logros-progreso');
  logrosProgresoOverlay = document.getElementById('logros-progreso-overlay');
  logrosDesbloqueados = document.getElementById('logros-desbloqueados');
  logrosLista = document.getElementById('logros-lista');
  toastLogro = document.getElementById('toast-logro');
  toastNombreLogro = document.getElementById('toast-nombre-logro');

  btnAccion = document.getElementById('btn-accion');
  btnMenu = document.getElementById('btn-menu');
  btnSonido = document.getElementById('btn-sonido');
  overlay = document.getElementById('overlay-menu');
  btnCerrarMenu = document.getElementById('btn-cerrar-menu');

  botonesNivel = [...document.querySelectorAll('.nivel-btn')];
  bancoNivel = document.getElementById('banco-nivel');
  nivelFinal = document.getElementById('nivel-final');
}

/* ---------- Estadísticas de partida para logros ---------- */
let statsPartida = {
  aciertos: 0,
  altitudMaxima: 0,
  comboMaximo: 0,
  tuvoLegendaria: false,
  logrosDesbloqueados: 0,
  rapidas: 0,
  rarasMuyRaras: 0,
  multiplicadorMaximo: 1,
  tiemposRespuesta: []
};

/* ---------- SVG decorativos ---------- */
const SVG_AVION = `
<svg viewBox="0 0 100 48" fill="currentColor" aria-hidden="true">
  <path d="M2 26 L44 22 L62 4 L72 4 L62 22 L96 18 L100 26 L96 34 L62 30 L72 46 L62 46 L44 30 L2 28 Z"/>
</svg>`;

const SVG_COHETE = `
<svg viewBox="0 0 40 80" aria-hidden="true">
  <path d="M20 0 C30 16 31 38 29 58 L11 58 C9 38 10 16 20 0 Z" fill="#243347"/>
  <path d="M11 58 L20 72 L29 58 Z" fill="#ff8a4d"/>
  <circle cx="20" cy="28" r="5.5" fill="#04070f"/>
  <path d="M14 58 L11 72 M26 58 L29 72" stroke="#ff8a4d" stroke-width="3" fill="none"/>
</svg>`;

function svgGlobo(color, luz) {
  return `
<svg viewBox="0 0 26 36" aria-hidden="true">
  <path d="M13 0 C6 0 2 5 2 12 C2 19 7 24 10 25 L16 25 C19 24 24 19 24 12 C24 5 20 0 13 0 Z" fill="${color}"/>
  <path d="M13 0 C9 2 7 7 7 12 C7 17 9 22 11 25 L13 25 Z" fill="${luz}" opacity="0.55"/>
  <path d="M16 0 C19 3 21 7 21 12 C21 17 19 21 17 24" fill="none" stroke="${luz}" stroke-width="1.5" opacity="0.7"/>
  <rect x="9" y="25" width="2" height="4" fill="#c9a15a"/>
  <rect x="15" y="25" width="2" height="4" fill="#c9a15a"/>
  <rect x="8" y="29" width="10" height="6" fill="#8a5a2b"/>
  <rect x="8" y="29" width="10" height="1" fill="#c08a4e"/>
  <rect x="10" y="31" width="6" height="2" fill="#d9a45f"/>
</svg>`;
}

const SVG_SATELITE = `
<svg viewBox="0 0 52 30" aria-hidden="true">
  <rect x="21" y="11" width="10" height="8" fill="#d7e3ee"/>
  <rect x="23" y="13" width="6" height="4" fill="#7f93a5"/>
  <rect x="2" y="10" width="18" height="10" fill="#2f5f96"/>
  <rect x="32" y="10" width="18" height="10" fill="#2f5f96"/>
  <rect x="6" y="10" width="1" height="10" fill="#5c93cf"/>
  <rect x="11" y="10" width="1" height="10" fill="#5c93cf"/>
  <rect x="16" y="10" width="1" height="10" fill="#5c93cf"/>
  <rect x="36" y="10" width="1" height="10" fill="#5c93cf"/>
  <rect x="41" y="10" width="1" height="10" fill="#5c93cf"/>
  <rect x="46" y="10" width="1" height="10" fill="#5c93cf"/>
  <rect x="25" y="5" width="2" height="6" fill="#9fb3c4"/>
  <rect x="23" y="3" width="6" height="2" fill="#ffd23f"/>
</svg>`;


/* ---------- Inicio ---------- */
document.addEventListener('DOMContentLoaded', () => {
  inicializarElementos();

  crearCajas();
  crearRegla();
  crearDecoracion();
  crearCapasZonas();
  aplicarProgreso(0);

  inicializarDificultad();
  cargarLogros();
  renderizarGridLogros();

  if (window.BANCO_INFO) {
    const infoBanco = document.getElementById('info-banco');
    const menuBanco = document.getElementById('menu-banco');
    const menuResp = document.getElementById('menu-respuestas');
    if (infoBanco) infoBanco.textContent = BANCO_INFO.preguntas.toLocaleString('es-ES') + ' preguntas';
    if (menuBanco) menuBanco.textContent = BANCO_INFO.preguntas.toLocaleString('es-ES');
    if (menuResp) menuResp.textContent = BANCO_INFO.unicas.toLocaleString('es-ES');
  }

  btnAccion.addEventListener('click', accionPrincipal);
  btnMenu.addEventListener('click', () => overlay.classList.add('activa'));
  btnCerrarMenu.addEventListener('click', () => overlay.classList.remove('activa'));
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) overlay.classList.remove('activa');
  });
  btnSonido.addEventListener('click', alternarSonido);

  btnLogros.addEventListener('click', abrirLogros);
  btnLogrosInicio.addEventListener('click', abrirLogros);
  btnCerrarLogros.addEventListener('click', cerrarLogros);
  overlayLogros.addEventListener('click', (e) => {
    if (e.target === overlayLogros) cerrarLogros();
  });

  window.addEventListener('resize', () => aplicarProgreso(puntosActuales));

  formRespuesta.addEventListener('submit', (e) => {
    e.preventDefault();
    enviarRespuesta();
  });

  // Animación de entrada inicial
  vistaInicio.classList.add('entrada');
});

/* ---------- Construcción de UI ---------- */
function crearCajas() {
  cajas.innerHTML = '';
  for (let i = 0; i < TOTAL_PREGUNTAS; i++) {
    const c = document.createElement('span');
    c.className = 'caja';
    cajas.appendChild(c);
  }
}

function crearRegla() {
  regla.innerHTML = '';
  for (let metros = 0; metros <= MAX_METROS; metros += 500) {
    const tick = document.createElement('div');
    tick.className = 'tick' + (metros % 1000 === 0 ? ' grande' : '');
    tick.style.bottom = (metros / MAX_METROS) * 100 + '%';
    tick.innerHTML = `<span class="num">${metros} m</span><span class="linea"></span>`;
    regla.appendChild(tick);
  }
}

function crearDecoracion() {
  for (let i = 0; i < 9; i++) {
    const n = document.createElement('div');
    n.className = 'nube';
    const u = 9 + Math.floor(Math.random() * 9);
    const filas = [
      { x: 3, y: 0, w: 4 },
      { x: 2, y: 1, w: 6 },
      { x: 0, y: 2, w: 8 },
      { x: 0, y: 3, w: 8 }
    ];
    n.style.width = 8 * u + 'px';
    n.style.height = 4 * u + 'px';
    n.style.opacity = 0.55 + Math.random() * 0.55;
    filas.forEach((f) => {
      const b = document.createElement('div');
      b.className = 'nube-barra';
      b.style.left = f.x * u + 'px';
      b.style.top = f.y * u + 'px';
      b.style.width = f.w * u + 'px';
      b.style.height = u + 'px';
      n.appendChild(b);
    });
    n.style.left = Math.random() * 85 + '%';
    n.style.top = 6 + Math.random() * 78 + '%';
    n.style.animationDuration = 45 + Math.random() * 45 + 's';
    n.style.animationDelay = -Math.random() * 70 + 's';
    capaNubes.appendChild(n);
  }

  /* globos aerostáticos: el primer tramo del vuelo */
  const COLORES_GLOBO = [
    ['#e8503a', '#ffb08a'],
    ['#f2b134', '#ffe08a'],
    ['#3aa6d8', '#9fe0ff'],
    ['#8a5ed8', '#d3b8ff'],
    ['#3ec98a', '#b3ffd9'],
    ['#e84a8a', '#ffb3d1']
  ];
  for (let i = 0; i < 8; i++) {
    const g = document.createElement('div');
    g.className = 'globo';
    const c = COLORES_GLOBO[i % COLORES_GLOBO.length];
    g.innerHTML = `<span class="globo-cuerpo">${svgGlobo(c[0], c[1])}</span>`;
    g.style.left = 4 + Math.random() * 86 + '%';
    g.style.width = 34 + Math.random() * 28 + 'px';
    g.style.animationDuration = 32 + Math.random() * 36 + 's';
    g.style.animationDelay = -Math.random() * 65 + 's';
    g.style.opacity = 0.7 + Math.random() * 0.3;
    capaGlobos.appendChild(g);
  }

  for (let i = 0; i < 4; i++) {
    const a = document.createElement('div');
    a.className = 'avion';
    a.innerHTML = SVG_AVION;
    a.style.top = 10 + Math.random() * 62 + '%';
    a.style.animationDuration = 26 + Math.random() * 24 + 's';
    a.style.animationDelay = -Math.random() * 45 + 's';
    capaAviones.appendChild(a);
  }

  for (let i = 0; i < 4; i++) {
    const c = document.createElement('div');
    c.className = 'cohete';
    c.innerHTML = SVG_COHETE;
    c.style.left = 8 + Math.random() * 80 + '%';
    c.style.animationDuration = 24 + Math.random() * 22 + 's';
    c.style.animationDelay = -Math.random() * 45 + 's';
    capaCohetes.appendChild(c);
  }

  /* satélites en órbita */
  for (let i = 0; i < 5; i++) {
    const s = document.createElement('div');
    s.className = 'satelite';
    s.innerHTML = SVG_SATELITE;
    s.style.top = 6 + Math.random() * 68 + '%';
    s.style.width = 44 + Math.random() * 30 + 'px';
    s.style.animationDuration = 38 + Math.random() * 34 + 's';
    s.style.animationDelay = -Math.random() * 60 + 's';
    capaOrbita.appendChild(s);
  }

  /* planetas gigantes */
  const PLANETAS = [
    ['#ffd9a8', '#e8892f', '#8a3a12'],
    ['#bfe6ff', '#3a8fd0', '#123c66'],
    ['#d6ffd9', '#46b57a', '#124a3a'],
    ['#f0d4ff', '#9a5cd8', '#3a1c5e'],
    ['#ffd0c0', '#d8583a', '#5e1a12'],
    ['#fff2b3', '#d8b83a', '#6e5410']
  ];
  for (let i = 0; i < 6; i++) {
    const p = document.createElement('div');
    p.className = 'planeta' + (i % 2 === 0 ? ' anillo' : '');
    const c = PLANETAS[i];
    const tam = 90 + Math.random() * 110;
    p.style.width = tam + 'px';
    p.style.height = tam + 'px';
    p.style.left = (i % 3 === 0 ? 2 + Math.random() * 16 : 56 + Math.random() * 34) + '%';
    p.style.backgroundImage =
      'repeating-linear-gradient(180deg, rgba(255,255,255,0.08) 0 4px, rgba(0,0,0,0.10) 4px 8px),' +
      'radial-gradient(circle at 32% 28%, ' + c[0] + ' 0%, ' + c[1] + ' 48%, ' + c[2] + ' 100%)';
    p.style.animationDuration = 100 + Math.random() * 80 + 's';
    p.style.animationDelay = -Math.random() * 160 + 's';
    capaPlanetas.appendChild(p);
  }

  /* galaxias lejanas */
  for (let i = 0; i < 4; i++) {
    const gx = document.createElement('div');
    gx.className = 'galaxia';
    const w = 150 + Math.random() * 130;
    gx.style.width = w + 'px';
    gx.style.height = (w * 0.52) + 'px';
    gx.style.left = (i % 2 === 0 ? 4 + Math.random() * 26 : 58 + Math.random() * 30) + '%';
    gx.style.background =
      'radial-gradient(ellipse 58% 16% at 50% 50%, rgba(255,255,255,0.80) 0%, rgba(210,160,255,0.42) 24%, transparent 68%),' +
      'radial-gradient(ellipse 34% 52% at 50% 50%, rgba(120,90,220,0.38) 0%, transparent 70%),' +
      'radial-gradient(ellipse 85% 62% at 50% 50%, rgba(90,40,140,0.30) 0%, transparent 72%)';
    gx.style.animationDuration = 130 + Math.random() * 80 + 's';
    gx.style.animationDelay = -Math.random() * 180 + 's';
    capaGalaxias.appendChild(gx);
  }

  for (let i = 0; i < 110; i++) {
    const e = document.createElement('div');
    e.className = 'estrella';
    const s = 1 + Math.random() * 2;
    e.style.width = s + 'px';
    e.style.height = s + 'px';
    e.style.left = Math.floor(Math.random() * 100) + '%';
    e.style.top = Math.floor(Math.random() * 100) + '%';
    e.style.animationDuration = 2 + Math.random() * 3 + 's';
    e.style.animationDelay = -Math.random() * 5 + 's';
    capaEstrellas.appendChild(e);
  }

  /* ráfagas verticales del ascenso */
  for (let i = 0; i < 20; i++) {
    const r = document.createElement('div');
    r.className = 'rayo';
    r.style.left = Math.random() * 100 + '%';
    r.style.width = 1 + Math.random() * 3 + 'px';
    r.style.height = 8 + Math.random() * 24 + 'vh';
    r.style.animationDuration = 0.45 + Math.random() * 0.5 + 's';
    r.style.animationDelay = -Math.random() + 's';
    r.style.setProperty('--op', (0.35 + Math.random() * 0.45).toFixed(2));
    efectoAscensoEl.appendChild(r);
  }
}

/* ---------- Crear capas de zonas (montañas, estratosfera) ---------- */
function crearCapasZonas() {
  /* Montañas */
  const SVG_MONTANA = `
  <svg viewBox="0 0 120 80" aria-hidden="true">
    <path d="M0 80 L20 30 L40 55 L60 15 L80 45 L100 10 L120 35 L120 80 Z" fill="#1a2a3a"/>
    <path d="M10 80 L25 40 L40 60 L55 25 L70 50 L85 20 L100 45 L110 80 Z" fill="#142030"/>
    <path d="M55 15 L60 8 L65 15" fill="none" stroke="#3a6f9e" stroke-width="1.5"/>
    <path d="M78 22 L82 12 L86 22" fill="none" stroke="#3a6f9e" stroke-width="1"/>
  </svg>`;

  for (let i = 0; i < 6; i++) {
    const m = document.createElement('div');
    m.className = 'montana';
    m.innerHTML = SVG_MONTANA;
    m.style.left = (i % 3 === 0 ? 2 + Math.random() * 18 : 50 + Math.random() * 40) + '%';
    m.style.width = 180 + Math.random() * 120 + 'px';
    m.style.animationDuration = 120 + Math.random() * 80 + 's';
    m.style.animationDelay = -Math.random() * 150 + 's';
    m.style.opacity = 0.6 + Math.random() * 0.3;
    capaMontanas.appendChild(m);
  }

  /* Estratosfera - elementos atmosféricos */
  const SVG_ESTRATOSFERA = [
    `<svg viewBox="0 0 60 30" aria-hidden="true"><path d="M5 15 Q30 5 55 15 Q30 25 5 15" fill="none" stroke="#5cd6ff" stroke-width="1.5" opacity="0.6"/><circle cx="30" cy="15" r="3" fill="#5cd6ff" opacity="0.8"/></svg>`,
    `<svg viewBox="0 0 50 20" aria-hidden="true"><path d="M0 10 Q25 0 50 10 Q25 20 0 10" fill="none" stroke="#7fe9ff" stroke-width="1" opacity="0.5"/><rect x="20" y="8" width="10" height="4" fill="#7fe9ff" opacity="0.7"/></svg>`,
    `<svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="#5cd6ff" stroke-width="1" opacity="0.4"/><circle cx="20" cy="20" r="12" fill="none" stroke="#7fe9ff" stroke-width="1" opacity="0.3"/></svg>`
  ];

  for (let i = 0; i < 8; i++) {
    const e = document.createElement('div');
    e.className = 'estratosfera-elemento';
    e.innerHTML = SVG_ESTRATOSFERA[i % SVG_ESTRATOSFERA.length];
    e.style.left = Math.random() * 100 + '%';
    e.style.top = 10 + Math.random() * 70 + '%';
    e.style.width = 40 + Math.random() * 60 + 'px';
    e.style.animationDuration = 60 + Math.random() * 60 + 's';
    e.style.animationDelay = -Math.random() * 100 + 's';
    e.style.opacity = 0.4 + Math.random() * 0.4;
    capaEstratosfera.appendChild(e);
  }
}

/* ---------- Escenarios ---------- */
function escenaActual() {
  return Math.min(aciertos, ESCENAS.length - 1);
}

function aplicarEscena(indice) {
  fondos.forEach((f, i) => f.classList.toggle('activa', i === indice));

  capaGlobos.classList.toggle('activa', indice <= 1);
  capaNubes.classList.toggle('activa', indice <= 2);
  capaNubes.classList.toggle('tenue', indice === 2);
  capaAviones.classList.toggle('activa', indice === 2);
  capaCohetes.classList.toggle('activa', indice === 3);
  capaOrbita.classList.toggle('activa', indice === 4);
  capaPlanetas.classList.toggle('activa', indice === 5);
  capaGalaxias.classList.toggle('activa', indice >= 6);

  capaEstrellas.classList.add('activa');
  capaEstrellas.classList.toggle('tenue', indice < 4);

  zonaActual.textContent = ESCENAS[indice].nombre;

  if (escenaMostrada !== -1 && escenaMostrada !== indice) {
    mostrarBanner(`ASCENSO · ${ESCENAS[indice].nombre}`);
    pajaro.classList.add('nivel-subida');
    setTimeout(() => pajaro.classList.remove('nivel-subida'), 800);
  }
  escenaMostrada = indice;
}

function mostrarBanner(texto) {
  banner.textContent = texto;
  banner.classList.add('visible');
  clearTimeout(bannerTimer);
  bannerTimer = setTimeout(() => banner.classList.remove('visible'), 2000);
}

/* ---------- Zonas de altitud ---------- */
function obtenerZona(altitud) {
  for (let i = ZONAS.length - 1; i >= 0; i--) {
    if (altitud >= ZONAS[i].altitudMin) return i;
  }
  return 0;
}

function aplicarZona(indice) {
  if (indice === zonaActualIndex) return;

  const zonaAnterior = zonaActualIndex;
  zonaActualIndex = indice;
  zonasVisitadas.add(indice);
  altitudMaximaPartida = Math.max(altitudMaximaPartida, ZONAS[indice].altitudMin);
  statsPartida.altitudMaxima = altitudMaximaPartida;

  const z = ZONAS[indice];

  /* Activar capa visual de la zona */
  const capas = {
    0: capaGlobos,
    1: capaMontanas,
    2: capaEstratosfera,
    3: capaOrbita,
    4: capaGalaxias
  };
  Object.values(capas).forEach((c) => c && c.classList.remove('activa'));
  if (capas[indice]) capas[indice].classList.add('activa');

  /* Efecto visual de cambio de zona: flash de pantalla con color de la zona */
  document.body.style.setProperty('--zona-color', ZONA_COLORES[indice] || '#7fe9ff');
  document.body.classList.add('zona-cambio');
  setTimeout(() => document.body.classList.remove('zona-cambio'), 800);

  /* Indicador de zona con animación - se queda visible durante toda la zona */
  zonaNombre.textContent = z.nombre;
  zonaAltitud.textContent = z.altitudMin + ' - ' + z.altitudMax + ' m';
  zonaIndicador.classList.add('visible', 'nueva-zona');
  // Quitar solo la animación de entrada, mantener visible
  setTimeout(() => {
    zonaIndicador.classList.remove('nueva-zona');
  }, 800);

  // Actualizar barra de progreso de la zona
  actualizarProgresoZona();

  mostrarBanner(`NUEVA ZONA · ${z.nombre}`);

  /* Logro: explorador por zona */
  if (indice === 1) comprobarLogro('explorador-montanas');
  if (indice === 2) comprobarLogro('explorador-estratosfera');
  if (indice === 3) comprobarLogro('explorador-espacio');
  if (indice === 4) comprobarLogro('explorador-universo');

  /* Animación del pájaro al cambiar de zona */
  pajaro.classList.add('nivel-subida');
  setTimeout(() => pajaro.classList.remove('nivel-subida'), 800);

  // Sonido de cambio de zona
  sonidoCambioZona(indice);
}

/* Actualiza la barra de progreso dentro de la zona actual */
function actualizarProgresoZona() {
  if (!zonaProgresoFill) return;
  const z = ZONAS[zonaActualIndex];
  const metros = aciertos * METROS_POR_ACIERTO;
  const progreso = Math.min(Math.max((metros - z.altitudMin) / (z.altitudMax - z.altitudMin), 0), 1) * 100;
  zonaProgresoFill.style.width = progreso + '%';
}

function sonidoCambioZona(indice) {
  inicializarAudio();
  const frecuencias = {
    0: [392, 523],      // Cielo
    1: [440, 587],      // Montañas
    2: [523, 698],      // Estratosfera
    3: [587, 784],      // Espacio
    4: [659, 880]       // Universo
  };
  const freq = frecuencias[indice] || frecuencias[0];
  freq.forEach((f, i) => {
    tono(f, i * 0.1, 0.18, 'sine', 0.06);
  });
}

/* ---------- Combo ---------- */
function actualizarCombo() {
  // Mostrar HUD desde combo 1
  if (comboActual >= 1) {
    hudCombo.classList.add('activo');
  } else {
    hudCombo.classList.remove('activo');
    hudCombo.classList.remove('nuevo-multiplicador');
    hudCombo.classList.remove('combo-up');
    hudCombo.classList.remove('combo-hito');
  }
  comboValor.textContent = 'x' + multiplicadorCombo;
  comboContador.textContent = comboActual;
}

function romperCombo() {
  if (comboActual >= 1) {
    // Notificación visual de combo roto
    hudCombo.classList.add('combo-break');
    crearParticulasComboRoto();
    setTimeout(() => hudCombo.classList.remove('combo-break'), 500);

    // Mostrar mensaje "Combo roto" temporal
    mostrarMensajeComboRoto();
  }
  comboActual = 0;
  multiplicadorCombo = 1;
  actualizarCombo();
}

function incrementarCombo(nivelRareza = 'muy-comun') {
  comboActual++;
  comboMaximoPartida = Math.max(comboMaximoPartida, comboActual);
  statsPartida.comboMaximo = comboMaximoPartida;

  const previo = multiplicadorCombo;
  // Multiplicadores progresivos balanceados:
  // x1: combo 1-2
  // x2: combo 3-4
  // x3: combo 5-7
  // x4: combo 8-10
  // x5: combo 11+
  if (comboActual >= 11) multiplicadorCombo = 5;
  else if (comboActual >= 8) multiplicadorCombo = 4;
  else if (comboActual >= 5) multiplicadorCombo = 3;
  else if (comboActual >= 3) multiplicadorCombo = 2;
  else multiplicadorCombo = 1;

  statsPartida.multiplicadorMaximo = Math.max(statsPartida.multiplicadorMaximo, multiplicadorCombo);

  // Detectar hitos de combo para animaciones especiales
  const hitos = [3, 5, 10, 15];
  const esHito = hitos.includes(comboActual);

  if (multiplicadorCombo > previo || esHito) {
    hudCombo.classList.remove('nuevo-multiplicador');
    hudCombo.classList.remove('combo-hito');
    hudCombo.classList.add('combo-up');

    if (esHito) {
      hudCombo.classList.add('combo-hito');
    }

    setTimeout(() => {
      hudCombo.classList.remove('combo-up');
      hudCombo.classList.remove('nuevo-multiplicador');
      hudCombo.classList.remove('combo-hito');
    }, 1000);

    // Partículas mejoradas según hito
    if (esHito) {
      crearParticulasComboHito(comboActual);
    } else {
      crearParticulasComboMejoradas('x' + multiplicadorCombo);
    }

    // Logro: maestro del combo (x5)
    if (multiplicadorCombo >= 5) {
      comprobarLogro('maestro-combo');
    }
  }

  // Partículas por rareza en el combo
  crearParticulasRareza(nivelRareza);

  actualizarCombo();
}

function crearParticulasComboRoto() {
  if (!particulasCombo) return;
  const rect = pajaro.getBoundingClientRect();
  const cx = rect.left + rect.width / 2;
  const cy = rect.top;

  for (let i = 0; i < 10; i++) {
    const p = document.createElement('div');
    p.className = 'particula-combo-roto';
    p.textContent = '✗';
    p.style.left = cx + (Math.random() * 60 - 30) + 'px';
    p.style.top = cy + (Math.random() * 20 - 10) + 'px';
    p.style.animationDelay = (i * 0.04) + 's';
    particulasCombo.appendChild(p);
    setTimeout(() => p.remove(), 1200);
  }
}

function mostrarMensajeComboRoto() {
  const rect = pajaro.getBoundingClientRect();
  const cx = rect.left + rect.width / 2;
  const cy = rect.top - 30;

  const msg = document.createElement('div');
  msg.className = 'mensaje-combo-roto';
  msg.textContent = 'COMBO ROTO';
  msg.style.left = cx + 'px';
  msg.style.top = cy + 'px';
  document.body.appendChild(msg);
  setTimeout(() => msg.remove(), 1000);
}

function crearParticulasComboHito(combo) {
  if (!particulasCombo) return;
  const rect = pajaro.getBoundingClientRect();
  const cx = rect.left + rect.width / 2;
  const cy = rect.top;

  const config = {
    3: { color: '#ffcc33', texto: '¡COMBO x3!', particulas: 12 },
    5: { color: '#ff66aa', texto: '¡COMBO x5!', particulas: 16 },
    10: { color: '#ff3388', texto: '¡COMBO x10!', particulas: 24 },
    15: { color: '#ff0066', texto: '¡COMBO x15!', particulas: 32 }
  };

  const cfg = config[combo] || config[3];

  // Texto principal del hito
  const msg = document.createElement('div');
  msg.className = 'mensaje-combo-hito';
  msg.textContent = cfg.texto;
  msg.style.left = cx + 'px';
  msg.style.top = cy - 40 + 'px';
  msg.style.color = cfg.color;
  document.body.appendChild(msg);
  setTimeout(() => msg.remove(), 1500);

  // Partículas explosión
  for (let i = 0; i < cfg.particulas; i++) {
    const p = document.createElement('div');
    p.className = 'particula-combo-hito';
    p.style.left = cx + 'px';
    p.style.top = cy + 'px';
    p.style.background = cfg.color;
    p.style.boxShadow = '0 0 8px ' + cfg.color;
    const angulo = (i / cfg.particulas) * Math.PI * 2;
    const dist = 80 + Math.random() * 60;
    p.style.setProperty('--tx', Math.cos(angulo) * dist + 'px');
    p.style.setProperty('--ty', Math.sin(angulo) * dist + 'px');
    p.style.animationDelay = (i * 0.015) + 's';
    particulasCombo.appendChild(p);
    setTimeout(() => p.remove(), 1200);
  }

  // Sonido especial por hito
  sonidoHitoCombo(combo);
}

function sonidoHitoCombo(combo) {
  inicializarAudio();
  const frecuencias = {
    3: [523, 659, 784],    // Do - Mi - Sol
    5: [659, 784, 1046],   // Mi - Sol - Do5
    10: [784, 1046, 1318], // Sol - Do5 - Mi5
    15: [1046, 1318, 1568] // Do5 - Mi5 - Sol5
  };
  const freq = frecuencias[combo] || frecuencias[3];
  freq.forEach((f, i) => {
    tono(f, i * 0.08, 0.15, 'sine', 0.08);
  });
}

function crearParticulasComboMejoradas(texto) {
  if (!particulasCombo) return;
  const rect = pajaro.getBoundingClientRect();
  const cx = rect.left + rect.width / 2;
  const cy = rect.top;
  for (let i = 0; i < 8; i++) {
    const p = document.createElement('div');
    p.className = 'particula-combo-mejorada';
    p.textContent = texto;
    p.style.left = cx + (Math.random() * 60 - 30) + 'px';
    p.style.top = cy + 'px';
    p.style.animationDelay = (i * 0.06) + 's';
    particulasCombo.appendChild(p);
    setTimeout(() => p.remove(), 1100);
  }
}

function crearParticulasRareza(nivel) {
  if (!particulasCombo) return;
  const rect = pajaro.getBoundingClientRect();
  const cx = rect.left + rect.width / 2;
  const cy = rect.top;

  const textos = {
    'muy-comun': ['+10', 'COMÚN'],
    'poco-comun': ['+25', 'POCO COMÚN'],
    'raro': ['+45', 'RARO'],
    'muy-raro': ['+70', 'MUY RARO'],
    'legendario': ['+100', 'LEGENDARIO']
  };

  const arr = textos[nivel] || ['+10', 'COMÚN'];
  const numParticulas = nivel === 'legendario' ? 12 : nivel === 'muy-raro' ? 8 : 5;

  for (let i = 0; i < numParticulas; i++) {
    const p = document.createElement('div');
    p.className = 'particula-rareza ' + nivel;
    p.textContent = i % 2 === 0 ? arr[0] : arr[1];
    p.style.left = cx + (Math.random() * 80 - 40) + 'px';
    p.style.top = cy + (Math.random() * 20 - 10) + 'px';
    p.style.animationDelay = (i * 0.05) + 's';
    particulasCombo.appendChild(p);
    setTimeout(() => p.remove(), nivel === 'legendario' ? 1400 : 1000);
  }

  // Explosión de partículas de colores
  if (nivel === 'legendario' || nivel === 'muy-raro') {
    crearExplosionParticulas(cx, cy, nivel);
  }
}

function crearExplosionParticulas(cx, cy, nivel) {
  const colores = {
    'muy-raro': ['#ffcc33', '#ffd966', '#ffe699', '#fff0cc'],
    'legendario': ['#ff66aa', '#ff99cc', '#ffccdd', '#ffe6f0', '#ff3388']
  };
  const arr = colores[nivel] || colores['muy-raro'];
  const num = nivel === 'legendario' ? 20 : 12;

  for (let i = 0; i < num; i++) {
    const p = document.createElement('div');
    p.className = 'particula-explosion';
    p.style.left = cx + 'px';
    p.style.top = cy + 'px';
    p.style.background = arr[i % arr.length];
    p.style.boxShadow = '0 0 6px ' + arr[i % arr.length];
    const angulo = (i / num) * Math.PI * 2;
    const dist = 60 + Math.random() * 80;
    p.style.setProperty('--tx', Math.cos(angulo) * dist + 'px');
    p.style.setProperty('--ty', Math.sin(angulo) * dist + 'px');
    p.style.animationDelay = (i * 0.02) + 's';
    particulasCombo.appendChild(p);
    setTimeout(() => p.remove(), 900);
  }
}

/* ---------- Logros ---------- */
function cargarLogros() {
  try {
    const guardado = localStorage.getItem('vueloLogros');
    if (guardado) {
      const arr = JSON.parse(guardado);
      arr.forEach((id) => logrosDesbloqueadosSet.add(id));
    }
  } catch (e) { /* ignorar errores de storage */ }
}

function guardarLogros() {
  try {
    localStorage.setItem('vueloLogros', JSON.stringify([...logrosDesbloqueadosSet]));
  } catch (e) { /* ignorar */ }
}

function comprobarLogro(idLogro, estadoPartida = null) {
  const logro = LOGROS.find((l) => l.id === idLogro);
  if (!logro || logrosDesbloqueadosSet.has(idLogro)) return;

  const s = estadoPartida || {
    aciertos: aciertos,
    altitudMaxima: altitudMaximaPartida,
    comboMaximo: comboMaximoPartida,
    tuvoLegendaria: statsPartida.tuvoLegendaria,
    logrosDesbloqueados: logrosDesbloqueadosSet.size,
    rapidas: statsPartida.rapidas,
    rarasMuyRaras: statsPartida.rarasMuyRaras,
    multiplicadorMaximo: statsPartida.multiplicadorMaximo
  };

  if (!logro.condicion(s)) return;

  desbloquearLogro(logro);
}

function desbloquearLogro(logro) {
  logrosDesbloqueadosSet.add(logro.id);
  statsPartida.logrosDesbloqueados = logrosDesbloqueadosSet.size;
  guardarLogros();

  /* Toast de notificación mejorado */
  if (toastNombreLogro) toastNombreLogro.textContent = logro.nombre;
  if (toastLogro) {
    toastLogro.classList.add('visible', 'mejorado');
    setTimeout(() => {
      toastLogro.classList.remove('visible', 'mejorado');
    }, 3000);
  }

  sonidoRareza('legendario');

  /* Añadir a la lista de resultados si estamos en pantalla de resultados */
  if (logrosLista && document.getElementById('pantalla-resultados').classList.contains('activa')) {
    const item = document.createElement('div');
    item.className = 'item-respuesta';
    item.innerHTML = `<span>🏆 ${logro.nombre}</span><span class="pts">${logro.descripcion}</span>`;
    logrosLista.appendChild(item);
    if (logrosDesbloqueados) logrosDesbloqueados.style.display = 'block';
  }

  renderizarGridLogros();
}

function renderizarGridLogros() {
  const grids = [logrosGrid, logrosGridOverlay].filter(Boolean);
  const progresos = [logrosProgreso, logrosProgresoOverlay].filter(Boolean);

  grids.forEach((grid) => {
    grid.innerHTML = '';
    LOGROS.forEach((l) => {
      const desbloqueado = logrosDesbloqueadosSet.has(l.id);
      const tarjeta = document.createElement('div');
      tarjeta.className = 'logro-tarjeta ' + (desbloqueado ? 'desbloqueado' : 'bloqueado');
      tarjeta.innerHTML =
        '<div class="logro-icono"><svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">' +
        l.icono + '</svg></div>' +
        '<div class="logro-nombre">' + l.nombre + '</div>' +
        '<div class="logro-descripcion">' + l.descripcion + '</div>' +
        '<div class="logro-progreso">' + (desbloqueado ? '✓' : '?') + '</div>';
      grid.appendChild(tarjeta);
    });
  });

  const total = LOGROS.length;
  const desbloqueados = logrosDesbloqueadosSet.size;
  progresos.forEach((p) => {
    p.textContent = desbloqueados + ' / ' + total + ' desbloqueados';
  });
}

function sonidoRareza(nivel) {
  inicializarAudio();
  const base = {
    'muy-comun': 392,
    'poco-comun': 440,
    'raro': 523,
    'muy-raro': 659,
    'legendario': 784
  }[nivel] || 523;
  tono(base, 0, 0.14);
  tono(base * 1.5, 0.08, 0.2);
  tono(base * 2, 0.16, 0.3);
}

function mostrarToastLogro(nombre) {
  if (toastNombreLogro) toastNombreLogro.textContent = nombre;
  if (toastLogro) {
    toastLogro.classList.add('visible', 'mejorado');
    setTimeout(() => toastLogro.classList.remove('visible', 'mejorado'), 3000);
  }
}

/* ---------- Pantalla de logros ---------- */
function abrirLogros() {
  renderizarGridLogros();
  if (overlayLogros) overlayLogros.classList.add('activa');
}

function cerrarLogros() {
  if (overlayLogros) overlayLogros.classList.remove('activa');
}

/* ---------- Pantalla de logros ---------- */
function abrirLogros() {
  renderizarGridLogros();
  if (overlayLogros) overlayLogros.classList.add('activa');
}

function cerrarLogros() {
  if (overlayLogros) overlayLogros.classList.remove('activa');
}

function aplicarProgreso(puntos) {
  puntosActuales = puntos;
  aplicarEscena(escenaActual());

  /* la altitud avanza un tramo entero por acierto: 1000 m */
  const metros = Math.min(aciertos, TOTAL_PREGUNTAS) * METROS_POR_ACIERTO;
  const t = Math.min(aciertos / TOTAL_PREGUNTAS, 1);
  /* el pájaro y la marca recorren la misma pista que la regla */
  const r = regla.getBoundingClientRect();
  const base = window.innerHeight - r.bottom;
  const alto = r.height;
  const altoPajaro = pajaro.offsetHeight;

  marcaTu.style.bottom = base + t * alto + 'px';
  pajaro.style.bottom = base + t * Math.max(alto - altoPajaro, 0) + 'px';

  hudAltitud.textContent = metros.toLocaleString('es-ES') + ' m';
  hudPuntaje.textContent = puntos;

  /* Zona de altitud según metros alcanzados */
  const zonaIdx = obtenerZona(metros);
  aplicarZona(zonaIdx);
}

function crearParticulasAcierto(nivel, puntos) {
  if (!particulasCombo) return;
  const rect = pajaro.getBoundingClientRect();
  const cx = rect.left + rect.width / 2;
  const cy = rect.top;

  // Partículas de "lluvia" de puntos
  const p = document.createElement('div');
  p.className = 'puntos-lluvia ' + nivel.replace('-', '-');
  p.textContent = '+' + puntos;
  p.style.left = cx + (Math.random() * 30 - 15) + 'px';
  p.style.top = cy + 'px';
  particulasCombo.appendChild(p);
  setTimeout(() => p.remove(), 1300);
}

function destello(nivel = 'poco-comun') {
  flash.className = 'flash activo rareza-' + nivel.replace('-', '-');
  setTimeout(() => flash.classList.remove('activo'), 100);
}

let ascensoTimer = null;

function efectoAscenso() {
  if (ascensoTimer) clearTimeout(ascensoTimer);

  document.body.classList.remove('ascendiendo');
  pajaro.classList.remove('trepando');
  efectoAscensoEl.classList.remove('activo');
  void pajaro.offsetWidth;

  document.body.classList.add('ascendiendo');
  pajaro.classList.add('trepando');
  efectoAscensoEl.classList.add('activo');

  ascensoTimer = setTimeout(() => {
    document.body.classList.remove('ascendiendo');
    pajaro.classList.remove('trepando');
    efectoAscensoEl.classList.remove('activo');
  }, 1650);
}

/* ---------- Acción principal ---------- */
function accionPrincipal() {
  if (estado === 'inicio') {
    iniciarPartida();
  } else if (estado === 'jugando') {
    enviarRespuesta();
  } else if (estado === 'resultados') {
    volverAlInicio();
  }
}

function mostrarVista(vista) {
  [vistaInicio, vistaJuego, vistaResultados, vistaLogros].forEach((v) => v.classList.remove('activa'));
  vista.classList.add('activa');
  vista.classList.add('entrada');
  setTimeout(() => vista.classList.remove('entrada'), 500);
}

/* ---------- Dificultad ---------- */
function bancoDeDificultad(clave) {
  const banco = window.PREGUNTAS_DIFICULTAD && window.PREGUNTAS_DIFICULTAD[clave];
  return banco && banco.length ? banco : PREGUNTAS;
}

function recordDeDificultad(clave) {
  const cfg = DIFICULTADES[clave] || DIFICULTADES.media;
  let valor = localStorage.getItem(cfg.record);
  /* compatibilidad con el récord antiguo, que era el de nivel medio */
  if (valor === null && clave === 'media') valor = localStorage.getItem('vueloRecord');
  return parseInt(valor || '0', 10) || 0;
}

function pintarRecord() {
  if (!recordEl) return;
  recordEl.textContent = recordDeDificultad(dificultadActual).toLocaleString('es-ES') + ' m';
}

function seleccionarDificultad(clave, guardar) {
  if (!DIFICULTADES[clave]) clave = 'media';
  dificultadActual = clave;
  tiempoLimite = DIFICULTADES[clave].tiempo;

  botonesNivel.forEach(function (b) {
    const activo = b.dataset.dificultad === clave;
    b.classList.toggle('activa', activo);
    b.setAttribute('aria-pressed', activo ? 'true' : 'false');
  });

  if (bancoNivel) {
    const n = bancoDeDificultad(clave).length;
    bancoNivel.textContent = n.toLocaleString('es-ES') + ' preguntas de nivel ' +
      DIFICULTADES[clave].nombre.toLowerCase() + ' · ' + tiempoLimite + ' s';
  }

  pintarRecord();
  actualizarTiempoMenuAyuda();
  if (guardar) localStorage.setItem('vueloDificultad', clave);
}

function inicializarDificultad() {
  const guardada = localStorage.getItem('vueloDificultad');
  seleccionarDificultad(DIFICULTADES[guardada] ? guardada : 'media', false);

  botonesNivel.forEach(function (b) {
    b.addEventListener('click', function () {
      seleccionarDificultad(b.dataset.dificultad, true);
      inicializarAudio();
      tono(520, 0, 0.08, 'square', 0.03);
    });
  });

  // Actualizar texto de tiempo en menú de ayuda
  actualizarTiempoMenuAyuda();
}

function actualizarTiempoMenuAyuda() {
  const menuTiempo = document.getElementById('menu-tiempo');
  if (menuTiempo) {
    menuTiempo.textContent = tiempoLimite;
  }
}

function volverAlInicio() {
  clearInterval(temporizadorId);
  estado = 'inicio';
  preguntaActual = 0;
  puntuacion = 0;
  aciertos = 0;
  respuestaDada = false;
  reintentando = false;
  transicionandoPregunta = false;
  escenaMostrada = -1;

  // Reset combo
  comboActual = 0;
  multiplicadorCombo = 1;
  comboMaximoPartida = 0;
  actualizarCombo();

  // Reset zonas
  zonaActualIndex = 0;
  altitudMaximaPartida = 0;
  zonasVisitadas = new Set([0]);
  const capas = { 0: capaGlobos, 1: capaMontanas, 2: capaEstratosfera, 3: capaOrbita, 4: capaGalaxias };
  Object.values(capas).forEach((c) => c && c.classList.remove('activa'));
  if (capas[0]) capas[0].classList.add('activa');

  // Reset stats
  statsPartida = {
    aciertos: 0,
    altitudMaxima: 0,
    comboMaximo: 0,
    tuvoLegendaria: false,
    logrosDesbloqueados: logrosDesbloqueadosSet.size,
    rapidas: 0,
    rarasMuyRaras: 0,
    multiplicadorMaximo: 1,
    tiemposRespuesta: []
  };

  mostrarVista(vistaInicio);
  document.body.classList.remove('ascendiendo', 'partida-completa', 'zona-cambio');
  pajaro.classList.remove('trepando', 'acertando', 'rara-legendaria', 'nivel-subida');
  efectoAscensoEl.classList.remove('activo');
  flash.classList.remove('activo');
  pajaro.classList.add('sin-transicion');
  aplicarProgreso(0);
  requestAnimationFrame(() => pajaro.classList.remove('sin-transicion'));
  actualizarCajas();
  hudEstado.textContent = 'DESPEGUE';
  btnAccion.textContent = 'DESPEGAR ▲';
  btnAccion.disabled = false;
  pintarRecord();

  // Limpiar partículas
  if (particulasCombo) particulasCombo.innerHTML = '';

  // Ocultar zona indicador
  zonaIndicador.classList.remove('visible', 'nueva-zona');

  // Ocultar logros desbloqueados en resultados
  if (logrosDesbloqueados) logrosDesbloqueados.style.display = 'none';
  if (logrosLista) logrosLista.innerHTML = '';
}

/* ---------- Partida ---------- */
function iniciarPartida() {
  estado = 'jugando';
  preguntaActual = 0;
  puntuacion = 0;
  aciertos = 0;
  respuestaDada = false;
  reintentando = false;
  transicionandoPregunta = false;
  preguntasPartida = [];
  escenaMostrada = -1;

  // Reset combo
  comboActual = 0;
  multiplicadorCombo = 1;
  comboMaximoPartida = 0;
  actualizarCombo();

  // Reset zonas
  zonaActualIndex = 0;
  altitudMaximaPartida = 0;
  zonasVisitadas = new Set([0]);
  const capas = { 0: capaGlobos, 1: capaMontanas, 2: capaEstratosfera, 3: capaOrbita, 4: capaGalaxias };
  Object.values(capas).forEach((c) => c && c.classList.remove('activa'));
  if (capas[0]) capas[0].classList.add('activa');

  // Reset stats
  statsPartida = {
    aciertos: 0,
    altitudMaxima: 0,
    comboMaximo: 0,
    tuvoLegendaria: false,
    logrosDesbloqueados: logrosDesbloqueadosSet.size,
    rapidas: 0,
    rarasMuyRaras: 0,
    multiplicadorMaximo: 1,
    tiemposRespuesta: []
  };

  const banco = bancoDeDificultad(dificultadActual);
  const mezcladas = [...banco].sort(() => 0.5 - Math.random());
  preguntasPartida = mezcladas.slice(0, TOTAL_PREGUNTAS);

  mostrarVista(vistaJuego);
  pajaro.classList.add('sin-transicion');
  aplicarProgreso(0);
  requestAnimationFrame(() => pajaro.classList.remove('sin-transicion'));
  actualizarCajas();
  cargarPregunta(0);

  // Limpiar partículas
  if (particulasCombo) particulasCombo.innerHTML = '';

  // Ocultar zona indicador
  zonaIndicador.classList.remove('visible', 'nueva-zona');

  // Ocultar logros desbloqueados
  if (logrosDesbloqueados) logrosDesbloqueados.style.display = 'none';
  if (logrosLista) logrosLista.innerHTML = '';
}

function actualizarCajas() {
  [...cajas.children].forEach((c, i) => {
    c.classList.toggle('hecha', i < preguntaActual);
    c.classList.toggle('actual', i === preguntaActual && estado === 'jugando');
  });
  hudEstado.textContent = estado === 'jugando'
    ? `VUELO ${preguntaActual + 1}/${TOTAL_PREGUNTAS}`
    : 'DESPEGUE';
}

function cargarPregunta(indice) {
  const p = preguntasPartida[indice];

  // Transición suave si no es la primera pregunta
  if (indice > 0) {
    vistaJuego.classList.add('vista-juego-transicion');
    setTimeout(() => vistaJuego.classList.remove('vista-juego-transicion'), 400);
  }

  textoPrompt.textContent = p.texto;
  inputRespuesta.value = '';
  inputRespuesta.disabled = false;
  inputRespuesta.classList.remove('sacudida');
  respuestaDada = false;
  reintentando = false;

  feedback.textContent = '';
  feedback.className = 'feedback';
  sublinea.textContent = 'escribe una respuesta antes de que acabe el tiempo';

  btnAccion.textContent = 'ENVIAR ▲';
  btnAccion.disabled = false;

  actualizarCajas();
  iniciarTemporizador();
  inputRespuesta.focus({ preventScroll: true });
}

function iniciarTemporizador() {
  clearInterval(temporizadorId);
  tiempoRestante = tiempoLimite;
  actualizarTiempo();

  temporizadorId = setInterval(() => {
    tiempoRestante--;
    actualizarTiempo();
    if (tiempoRestante <= 0) {
      clearInterval(temporizadorId);
      tiempoAgotado();
    }
  }, 1000);
}

function actualizarTiempo() {
  const proporcion = Math.max(tiempoRestante, 0) / tiempoLimite;
  barraFill.style.width = proporcion * 100 + '%';
  barraFill.classList.toggle('urgente', tiempoRestante <= 5);
  if (reintentando && !respuestaDada && estado === 'jugando') {
    sublinea.textContent = `sigue intentando · ${Math.max(tiempoRestante, 0)} s`;
  }
}

function tiempoAgotado() {
  if (respuestaDada) return;
  respuestaDada = true;
  reintentando = false;
  bloquear();

  const pregunta = preguntasPartida[preguntaActual];
  pregunta.puntosObtenidos = 0;
  pregunta.respuestaUsuario = '';

  feedback.textContent = '+0 PUNTOS';
  feedback.className = 'feedback cero';
  sublinea.textContent = 'el reloj se te adelantó';

  setTimeout(siguientePregunta, 1500);
}

function enviarRespuesta() {
  if (respuestaDada || estado !== 'jugando' || transicionandoPregunta) return;

  const texto = inputRespuesta.value.trim();
  if (!texto) return;

  const pregunta = preguntasPartida[preguntaActual];
  const acierto = buscarRespuestaAvanzada(pregunta, texto);

  if (acierto) {
    clearInterval(temporizadorId);
    respuestaDada = true;
    reintentando = false;
    transicionandoPregunta = true;
    bloquear();

    // Calcular tiempo de respuesta para logro "velocista"
    const tiempoRespuesta = tiempoLimite - tiempoRestante;
    statsPartida.tiemposRespuesta.push(tiempoRespuesta);
    if (tiempoRespuesta <= 10) statsPartida.rapidas++;

    // Contar rarezas para logro "cazador-raro"
    if (acierto.nivel === 'muy-raro' || acierto.nivel === 'legendario') {
      statsPartida.rarasMuyRaras++;
    }
    if (acierto.nivel === 'legendario') {
      statsPartida.tuvoLegendaria = true;
      comprobarLogro('palabra-legendaria');
    }

    puntuacion += acierto.puntos * multiplicadorCombo;
    aciertos++;
    pregunta.puntosObtenidos = acierto.puntos * multiplicadorCombo;
    pregunta.respuestaUsuario = texto;

    // Incrementar combo con info de rareza
    incrementarCombo(acierto.nivel);

    feedback.textContent = `+${acierto.puntos * multiplicadorCombo} PUNTOS`;
    if (multiplicadorCombo > 1) {
      feedback.textContent += ` (x${multiplicadorCombo})`;
    }
    feedback.className = 'feedback';

    let extra = `${obtenerNombreNivel(acierto.nivel)} · +${METROS_POR_ACIERTO} m`;
    if (multiplicadorCombo > 1) extra += ` · COMBO x${multiplicadorCombo}`;
    if (acierto.corregida) extra += ` · corregido: «${acierto.texto}»`;
    else if (acierto.libre) extra += ' · válida (no registrada)';
    sublinea.textContent = extra;

    // Animaciones según rareza
    pajaro.classList.add('acertando');
    if (acierto.nivel === 'legendario' || acierto.nivel === 'muy-raro') {
      pajaro.classList.add('rara-legendaria');
    }
    setTimeout(() => {
      pajaro.classList.remove('acertando');
      pajaro.classList.remove('rara-legendaria');
    }, acierto.nivel === 'legendario' ? 1000 : 600);

    efectoAscenso();
    aplicarProgreso(puntuacion);
    destello(acierto.nivel);
    mostrarFlotante('+' + METROS_POR_ACIERTO + ' m');
    crearParticulasAcierto(acierto.nivel, acierto.puntos * multiplicadorCombo);
    sonidoAcierto(acierto.nivel);

    setTimeout(() => {
      transicionandoPregunta = false;
      siguientePregunta();
    }, 1700);
  } else {
    /* Fallar NO pasa de pregunta: el reloj sigue corriendo. */
    reintentando = true;
    feedback.textContent = 'NO ESTÁ EN LA LISTA';
    feedback.className = 'feedback cero';
    sublinea.textContent = `sigue intentando · ${Math.max(tiempoRestante, 0)} s`;

    // Romper combo al fallar
    if (comboActual > 0) {
      romperCombo();
    }

    // Animación de fallo del pájaro
    pajaro.classList.add('fallando');
    setTimeout(() => pajaro.classList.remove('fallando'), 500);

    inputRespuesta.classList.remove('sacudida');
    void inputRespuesta.offsetWidth;
    inputRespuesta.classList.add('sacudida');
    inputRespuesta.select();

    sonidoFallo();
  }
}

function bloquear() {
  inputRespuesta.disabled = true;
  btnAccion.disabled = true;
}

function mostrarFlotante(texto) {
  const rect = pajaro.getBoundingClientRect();
  const el = document.createElement('div');
  el.className = 'flotante';
  el.textContent = texto;
  el.style.left = rect.left + rect.width / 2 - 18 + 'px';
  el.style.top = rect.top - 12 + 'px';
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 1300);
}

function siguientePregunta() {
  preguntaActual++;
  if (preguntaActual < TOTAL_PREGUNTAS) {
    cargarPregunta(preguntaActual);
  } else {
    terminarPartida();
  }
}

function terminarPartida() {
  clearInterval(temporizadorId);
  estado = 'resultados';

  const metros = aciertos * METROS_POR_ACIERTO;
  const cfg = DIFICULTADES[dificultadActual] || DIFICULTADES.media;
  const recordPrevio = recordDeDificultad(dificultadActual);
  let nuevoRecord = false;
  if (metros > recordPrevio) {
    localStorage.setItem(cfg.record, String(metros));
    pintarRecord();
    nuevoRecord = true;
  }

  // Actualizar stats finales
  statsPartida.aciertos = aciertos;
  statsPartida.altitudMaxima = altitudMaximaPartida;
  statsPartida.comboMaximo = comboMaximoPartida;

  // Comprobar logros finales
  comprobarLogro('primer-vuelo');
  comprobarLogro('racha-perfecta');
  comprobarLogro('gran-aviador');
  comprobarLogro('perfeccionista');
  comprobarLogro('velocista');
  comprobarLogro('cazador-raro');
  comprobarLogro('coleccionista');
  comprobarLogro('maestro-combo');

  aplicarProgreso(puntuacion);
  zonaFinal.textContent = ESCENAS[escenaActual()].nombre;

  puntosFinales.textContent = `+${puntuacion} PUNTOS`;
  puntosFinales.className = 'puntos-grande' + (puntuacion === 0 ? ' cero' : '');
  // Animación de puntos finales
  setTimeout(() => {
    puntosFinales.classList.add('final-anim');
  }, 100);

  if (nuevoRecord) {
    puntosFinales.classList.add('nuevo-record');
    // Efecto visual de nuevo récord
    document.body.classList.add('partida-completa');
    setTimeout(() => document.body.classList.remove('partida-completa'), 1500);

    // Celebración del pájaro por récord
    pajaro.classList.add('celebrando-final');
    setTimeout(() => pajaro.classList.remove('celebrando-final'), 2000);
  } else if (aciertos >= 5) {
    // Celebración por buena partida (5+ aciertos)
    pajaro.classList.add('celebrando');
    setTimeout(() => pajaro.classList.remove('celebrando'), 800);
  }

  calificacionFinal.textContent = `${obtenerCalificacion(puntuacion)} · ${metros} m`;
  if (nivelFinal) nivelFinal.textContent = `nivel ${cfg.nombre.toLowerCase()} · ${cfg.tiempo} s por pregunta`;

  resumen.innerHTML = '';
  preguntasPartida.forEach((p) => {
    const pts = p.puntosObtenidos || 0;
    const fila = document.createElement('div');
    fila.className = 'item-respuesta';
    fila.innerHTML = `<span>${p.texto}</span><span class="pts${pts === 0 ? ' cero' : ''}">+${pts}</span>`;
    resumen.appendChild(fila);
  });

  // Mostrar racha perfecta si aplica
  if (comboMaximoPartida >= 7) {
    mostrarRachaPerfecta();
  }

  mostrarVista(vistaResultados);
  actualizarCajas();
  hudEstado.textContent = 'VUELO COMPLETADO';

  btnAccion.textContent = 'VOLVER AL INICIO ▲';
  btnAccion.disabled = false;

  sonidoFinal(puntuacion);
}

function mostrarRachaPerfecta() {
  const indicador = document.createElement('div');
  indicador.className = 'racha-perfecta-indicador';
  indicador.innerHTML = `
    <span class="racha-texto">racha perfecta</span>
    <span class="racha-numero">${comboMaximoPartida}</span>
  `;
  document.body.appendChild(indicador);
  setTimeout(() => indicador.remove(), 2200);
}

/* ---------- Calificaciones ---------- */
function obtenerCalificacion(puntos) {
  if (puntos >= 450) return 'legendario';
  if (puntos >= 351) return 'muy raro';
  if (puntos >= 251) return 'raro';
  if (puntos >= 151) return 'poco común';
  return 'común';
}

function obtenerNombreNivel(nivel) {
  const nombres = {
    'muy-comun': 'pluma común',
    'poco-comun': 'pluma poco común',
    'raro': 'pluma rara',
    'muy-raro': 'pluma muy rara',
    'legendario': '¡pluma legendaria!'
  };
  return nombres[nivel] || '';
}

/* ---------- Sonido ---------- */
function inicializarAudio() {
  if (!audioCtx) {
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (Ctx) audioCtx = new Ctx();
  }
  if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
}

function tono(frecuencia, retraso, duracion, tipo = 'sine', volumen = 0.06) {
  if (!audioCtx || !sonidoActivo) return;
  const osc = audioCtx.createOscillator();
  const gan = audioCtx.createGain();
  osc.type = tipo;
  osc.frequency.value = frecuencia;
  const t0 = audioCtx.currentTime + retraso;
  gan.gain.setValueAtTime(0.0001, t0);
  gan.gain.linearRampToValueAtTime(volumen, t0 + 0.012);
  gan.gain.exponentialRampToValueAtTime(0.0001, t0 + duracion);
  osc.connect(gan);
  gan.connect(audioCtx.destination);
  osc.start(t0);
  osc.stop(t0 + duracion + 0.03);
}

function sonidoAcierto(nivel) {
  inicializarAudio();
  const base = {
    'muy-comun': 392,
    'poco-comun': 440,
    'raro': 523,
    'muy-raro': 659,
    'legendario': 784
  }[nivel] || 523;
  tono(base, 0, 0.16);
  tono(base * 1.5, 0.1, 0.24);
  if (nivel === 'legendario') tono(base * 2, 0.2, 0.32);
}

function sonidoFallo() {
  inicializarAudio();
  tono(196, 0, 0.16, 'square', 0.045);
  tono(147, 0.12, 0.22, 'square', 0.045);
}

function sonidoFinal(puntos) {
  inicializarAudio();
  const nota = puntos >= 450 ? 784 : puntos >= 251 ? 659 : 523;
  tono(nota, 0, 0.18);
  tono(nota * 1.25, 0.14, 0.2);
  tono(nota * 1.5, 0.28, 0.3);
}

function alternarSonido() {
  sonidoActivo = !sonidoActivo;
  btnSonido.classList.toggle('mudo', !sonidoActivo);
  btnSonido.setAttribute('aria-label', sonidoActivo ? 'Silenciar sonido' : 'Activar sonido');
  if (sonidoActivo) {
    inicializarAudio();
    tono(660, 0, 0.12);
  }
}

/* ---------- Utilidades ---------- */
function normalizar(texto) {
  return texto
    .toString()
    .trim()
    .toLowerCase()
    .replace(/ñ/g, '\u0001')
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/\u0001/g, 'ñ')
    .replace(/[^a-z0-9ñ ]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/^(el|la|los|las|un|una|unos|unas) /, '');
}

/* Normalización agresiva para comparación fuzzy: quita espacios, guiones, signos */
function normalizarFuzzy(texto) {
  return normalizar(texto)
    .replace(/[^a-z0-9ñ]/g, '')
    .trim();
}

/* formas equivalentes: singular/plural, con o sin tilde final */
function variantes(palabra) {
  const set = new Set([palabra]);
  if (palabra.length > 4 && palabra.endsWith('ces')) set.add(palabra.slice(0, -3) + 'z');
  if (palabra.length > 4 && palabra.endsWith('es')) set.add(palabra.slice(0, -2));
  if (palabra.length > 3 && palabra.endsWith('s')) set.add(palabra.slice(0, -1));
  set.add(palabra + 's');
  if (palabra.endsWith('z')) set.add(palabra.slice(0, -1) + 'ces');
  return set;
}

/* ---------- Jaro-Winkler similarity (para fuzzy matching inteligente) ---------- */
function jaroWinkler(s1, s2) {
  if (s1 === s2) return 1.0;
  const len1 = s1.length, len2 = s2.length;
  if (len1 === 0 || len2 === 0) return 0.0;

  const matchWindow = Math.floor(Math.max(len1, len2) / 2) - 1;
  const s1Matches = new Array(len1).fill(false);
  const s2Matches = new Array(len2).fill(false);

  let matches = 0;
  for (let i = 0; i < len1; i++) {
    const start = Math.max(0, i - matchWindow);
    const end = Math.min(i + matchWindow + 1, len2);
    for (let j = start; j < end; j++) {
      if (s2Matches[j] || s1[i] !== s2[j]) continue;
      s1Matches[i] = s2Matches[j] = true;
      matches++;
      break;
    }
  }
  if (matches === 0) return 0.0;

  let transpositions = 0;
  let k = 0;
  for (let i = 0; i < len1; i++) {
    if (!s1Matches[i]) continue;
    while (!s2Matches[k]) k++;
    if (s1[i] !== s2[k]) transpositions++;
    k++;
  }
  transpositions /= 2;

  let jaro = (matches / len1 + matches / len2 + (matches - transpositions) / matches) / 3;

  // Winkler boost for common prefix (up to 4 chars)
  let prefix = 0;
  for (let i = 0; i < Math.min(len1, len2, 4); i++) {
    if (s1[i] === s2[i]) prefix++;
    else break;
  }
  return jaro + 0.1 * prefix * (1 - jaro);
}

/* ---------- Levenshtein distance (Damerau-Levenshtein con transposiciones) ---------- */
function distanciaLevenshtein(a, b) {
  const m = a.length, n = b.length;
  if (Math.abs(m - n) > 4) return 99; // early exit

  const d = [];
  for (let i = 0; i <= m; i++) {
    d[i] = [i];
    for (let j = 1; j <= n; j++) d[i][j] = i === 0 ? j : 0;
  }

  for (let i = 1; i <= m; i++) {
    for (let j = 1; j <= n; j++) {
      const coste = a[i - 1] === b[j - 1] ? 0 : 1;
      d[i][j] = Math.min(
        d[i - 1][j] + 1,      // deletion
        d[i][j - 1] + 1,      // insertion
        d[i - 1][j - 1] + coste // substitution
      );
      // transposition (Damerau)
      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {
        d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
      }
    }
  }
  return d[m][n];
}

/* ---------- Umbral dinámico según longitud ---------- */
function umbralDistancia(longitud) {
  if (longitud <= 4) return 1;
  if (longitud <= 7) return 1;
  if (longitud <= 10) return 2;
  return 3;
}

/* ---------- Jaro-Winkler threshold según longitud ---------- */
function umbralJaro(longitud) {
  if (longitud <= 4) return 0.95;
  if (longitud <= 7) return 0.90;
  if (longitud <= 10) return 0.87;
  return 0.84;
}

/* ---------- Comprobar si una respuesta parcial es inequívoca ---------- */
function esParcialValida(parcial, objetivo, todasRespuestas) {
  if (parcial.length < 4) return false;
  if (parcial === objetivo) return false; // ya es exacta

  let coincidencias = 0;
  let respuestaCoincidente = null;

  for (const r of todasRespuestas) {
    const alias = r.alias || [r.texto];
    for (const a of alias) {
      const n = normalizar(a);
      if (!n) continue;
      // ¿La respuesta empieza con la parcial? ¿O la contiene como palabra completa?
      const palabras = n.split(' ');
      for (const p of palabras) {
        if (p.startsWith(parcial) || p === parcial) {
          coincidencias++;
          respuestaCoincidente = r;
          break;
        }
      }
      if (coincidencias > 1) return false; // ambigua
    }
  }
  return coincidencias === 1 ? respuestaCoincidente : false;
}

/* ---------- Sistema de registro de respuestas rechazadas (aprendizaje) ---------- */
function registrarRespuestaRechazada(pregunta, respuestaUsuario) {
  try {
    const key = 'respuestas_rechazadas';
    const data = JSON.parse(localStorage.getItem(key) || '{}');
    const pid = pregunta.id || pregunta.categoria || 'desconocida';
    const norm = normalizar(respuestaUsuario);
    if (!norm) return;

    if (!data[pid]) data[pid] = {};
    data[pid][norm] = (data[pid][norm] || 0) + 1;
    data[pid][norm + '_original'] = respuestaUsuario.trim();
    data[pid][norm + '_fecha'] = Date.now();
    data[pid][norm + '_pregunta'] = pregunta.texto;

    localStorage.setItem(key, JSON.stringify(data));
  } catch (e) {
    console.warn('No se pudo guardar respuesta rechazada:', e);
  }
}

/* ---------- Obtener estadísticas de rechazadas para revisión ---------- */
function obtenerRespuestasRechazadas() {
  try {
    return JSON.parse(localStorage.getItem('respuestas_rechazadas') || '{}');
  } catch (e) {
    return {};
  }
}

/* ---------- Limpiar rechazadas antiguas ---------- */
function limpiarRespuestasRechazadas() {
  localStorage.removeItem('respuestas_rechazadas');
}

function buscarRespuesta(pregunta, respuestaUsuario) {
  const objetivo = normalizar(respuestaUsuario);
  if (!objetivo) return null;

  const formas = variantes(objetivo);
  const objetivoFuzzy = normalizarFuzzy(objetivo);

  /* 1 · coincidencia exacta (con plurales, artículos y alias) */
  for (let i = 0; i < pregunta.respuestas.length; i++) {
    const r = pregunta.respuestas[i];
    const alias = r.alias || [r.texto];
    for (let j = 0; j < alias.length; j++) {
      const n = normalizar(alias[j]);
      if (!n) continue;
      if (formas.has(n)) return r;
      const suyas = variantes(n);
      for (const v of suyas) {
        if (formas.has(v)) return r;
      }
    }
  }

  /* 1b · apellido o última palabra de un nombre compuesto */
  const porApellido = buscarPorUltimaPalabra(pregunta, objetivo);
  if (porApellido) return porApellido;

  /* 1c · respuesta parcial inequívoca (ej: "globo" para "pez globo") */
  const parcial = esParcialValida(objetivo, objetivo, pregunta.respuestas);
  if (parcial) return parcial;

  /* 2 · fuzzy matching inteligente: Jaro-Winkler + Levenshtein combinados */
  const aproximada = buscarAproximadaMejorada(pregunta, objetivo, objetivoFuzzy, respuestaUsuario);
  if (aproximada) return aproximada;

  /* 3 · registrar respuesta rechazada para aprendizaje */
  registrarRespuestaRechazada(pregunta, respuestaUsuario);

  return null;
}

/* Acepta "miró" para "Joan Miró" o "merkel" para "Angela Merkel"
   solo si esa última palabra identifica a una única respuesta. */
function buscarPorUltimaPalabra(pregunta, objetivo) {
  if (objetivo.indexOf(' ') !== -1 || objetivo.length < 4) return null;

  const formas = variantes(objetivo);
  let encontrada = null;
  let repetida = false;

  for (let i = 0; i < pregunta.respuestas.length; i++) {
    const r = pregunta.respuestas[i];
    const alias = r.alias || [r.texto];
    for (let j = 0; j < alias.length; j++) {
      const n = normalizar(alias[j]);
      if (!n || n.indexOf(' ') === -1) continue;
      const partes = n.split(' ');
      const ultima = partes[partes.length - 1];
      if (ultima.length < 4) continue;
      const suyas = variantes(ultima);
      let coincide = false;
      for (const v of suyas) {
        if (formas.has(v)) { coincide = true; break; }
      }
      if (!coincide) continue;
      if (encontrada && encontrada.clave !== r.clave) repetida = true;
      else encontrada = r;
    }
  }

  return repetida ? null : encontrada;
}

/* ---------- Búsqueda aproximada mejorada con Jaro-Winkler + Levenshtein ---------- */
function buscarAproximadaMejorada(pregunta, objetivo, objetivoFuzzy, original) {
  if (objetivo.length < 4) return null;

  const umbralLev = umbralDistancia(objetivo.length);
  const umbralJW = umbralJaro(objetivo.length);
  const inicial = objetivo.charAt(0);

  let mejor = null;
  let mejorLev = 99;
  let mejorJW = 0;
  let empate = false;

  pregunta.respuestas.forEach(function (r) {
    const alias = r.alias || [r.texto];
    alias.forEach(function (a) {
      const n = normalizar(a);
      const nFuzzy = normalizarFuzzy(n);
      if (!n || n.charAt(0) !== inicial) return;
      if (Math.abs(n.length - objetivo.length) > umbralLev + 1) return;

      // Levenshtein distance
      const d = distanciaLevenshtein(objetivo, n);
      // Jaro-Winkler similarity
      const jw = jaroWinkler(objetivoFuzzy, nFuzzy);

      // Debe pasar AMBOS filtros para evitar falsos positivos
      const pasaLev = d <= umbralLev;
      const pasaJW = jw >= umbralJW;

      if (!pasaLev && !pasaJW) return;

      // Puntuación combinada: prioriza Levenshtein exacto, usa JW como desempate
      const score = pasaLev ? (100 - d * 10 + jw * 10) : (jw * 50);

      if (score > mejorJW || (score === mejorJW && d < mejorLev)) {
        mejor = r;
        mejorLev = d;
        mejorJW = score;
        empate = false;
      } else if (score === mejorJW && mejor && r.clave !== mejor.clave) {
        empate = true;
      }
    });
  });

  if (!mejor || empate) return null;

  // Verificación extra: evitar falsos positivos entre conceptos distintos
  // (ej: "leon" no debe coincidir con "tigre" aunque tengan distancia similar)
  const aliasMejor = mejor.alias || [mejor.texto];
  let coincidenciaSegura = false;
  for (const a of aliasMejor) {
    const n = normalizar(a);
    const nFuzzy = normalizarFuzzy(n);
    const d = distanciaLevenshtein(objetivo, n);
    const jw = jaroWinkler(objetivoFuzzy, nFuzzy);
    if (d <= umbralLev && jw >= umbralJW) {
      coincidenciaSegura = true;
      break;
    }
  }

  if (!coincidenciaSegura) return null;

  return Object.assign({}, mejor, { corregida: true, original: original });
}

/* Mantener compatibilidad: alias para el código antiguo */
function distancia(a, b) {
  return distanciaLevenshtein(a, b);
}

function buscarAproximada(pregunta, objetivo, original) {
  return buscarAproximadaMejorada(pregunta, objetivo, normalizarFuzzy(objetivo), original);
}
function cumpleFiltro(clave, filtro) {
  if (!filtro) return false;
  if (filtro.tipo === 'inicial') return clave.charAt(0) === filtro.valor;
  if (filtro.tipo === 'final') return clave.charAt(clave.length - 1) === filtro.valor;
  if (filtro.tipo === 'contiene') return clave.indexOf(filtro.valor) !== -1;
  if (filtro.tipo === 'largo') return clave.indexOf(' ') === -1 && clave.length === filtro.valor;
  return false;
}
